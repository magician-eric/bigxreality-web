    },
    {
     "slug": "related_solutions",
     "label": "關聯解決方案",
     "type": "reference",
     "validation": {
      "relation": "product_solutions"
     }
    },
    {
     "slug": "integrated_scenarios",
     "label": "參與的整合訓練情境",
     "type": "reference",
     "validation": {
      "relation": "product_scenarios"
     }
    },
    {
     "slug": "domains",
     "label": "領域",
     "type": "multiSelect",
     "required": true,
     "validation": {
      "options": [
       "military",
       "police",
       "fire-rescue",
       "smart-city"
      ]
