    {
     "slug": "deploy_notes",
     "label": "部署說明",
     "type": "text"
    },
    {
     "slug": "integrated_ops_description",
     "label": "整合作戰說明",
     "type": "text"
    },
    {
     "slug": "integrated_products",
     "label": "可整合的產品",
     "type": "reference",
     "validation": {
      "relation": "product_integrations",
      "relationSide": "parent"
     }
    },
    {
     "slug": "integrated_by",
