       {
        "slug": "name",
        "label": "名稱",
        "type": "string",
        "required": true
       },
       {
        "slug": "description",
        "label": "說明",
        "type": "text",
        "required": true
       }
      ]
     }
    },
    {
     "slug": "deploy_personnel",
     "label": "部署人數（例：1-4）或 [待提供]",
     "type": "string",
     "validation": {
      "pattern": "^(\\d+(-\\d+)?|\\[待提供\\])$"
     },
     "translatable": false
    },
    {
     "slug": "deploy_personnel_approx",
     "label": "人數前加「約」",
     "type": "boolean",
     "defaultValue": false,
     "translatable": false
    },
    {
     "slug": "deploy_area",
     "label": "空間（m²）或 [待提供]",
     "type": "string",
     "validation": {
      "pattern": "^(\\d+(\\.\\d+)?|\\[待提供\\])$"
     },
     "translatable": false
    },
    {
     "slug": "deploy_setup_time",
     "label": "建置時間（分鐘）或 [待提供]",
     "type": "string",
     "validation": {
      "pattern": "^(\\d+(\\.\\d+)?|\\[待提供\\])$"
     },
     "translatable": false
