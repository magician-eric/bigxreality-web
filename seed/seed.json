{
 "$schema": "https://emdashcms.com/seed.schema.json",
 "version": "1",
 "defaultLocale": "en",
 "meta": {
  "name": "Big x Reality",
  "description": "Big x Reality 官網內容模型（docs/PHASE-2-PLAN.md §3）"
 },
 "settings": {
  "title": "Big x Reality",
  "tagline": "Turn every drill into real."
 },
 "collections": [
  {
   "slug": "products",
   "label": "產品",
   "labelSingular": "產品",
   "icon": "cube",
   "group": "產品與解決方案",
   "sortOrder": 1,
   "supports": [
    "drafts",
    "revisions",
    "preview",
    "scheduling",
    "seo"
   ],
   "urlPattern": "/{slug}",
   "titleField": "title",
   "admin": {
    "listColumns": [
     "code",
     "translation_status"
    ]
   },
   "fields": [
    {
     "slug": "title",
     "label": "產品名稱",
     "type": "string",
     "required": true
    },
    {
     "slug": "translation_status",
     "label": "翻譯狀態",
     "type": "select",
     "required": true,
     "defaultValue": "pending",
     "validation": {
      "options": [
       "source",
       "pending",
       "translated"
      ]
     }
    },
    {
     "slug": "review_status",
     "label": "審核狀態",
     "type": "select",
     "required": true,
     "defaultValue": "draft",
     "validation": {
      "options": [
       "draft",
       "submitted",
       "changes_requested",
       "approved"
      ]
     },
     "translatable": false
    },
    {
     "slug": "english_name",
     "label": "英文名",
     "type": "string",
     "required": true
    },
    {
     "slug": "code",
     "label": "代號（同時用於表單預填）",
     "type": "string",
     "required": true,
     "translatable": false
    },
    {
     "slug": "tagline",
     "label": "一句話定位",
     "type": "text",
     "required": true
    },
    {
     "slug": "hero_image",
     "label": "主圖（替代文字依語言填寫）",
     "type": "image"
    },
    {
     "slug": "summary",
     "label": "卡片短描述（空白時用一句話定位）",
     "type": "text"
    },
    {
     "slug": "overview",
     "label": "產品概述",
     "type": "portableText"
    },
    {
     "slug": "capabilities",
