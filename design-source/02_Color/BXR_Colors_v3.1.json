 "rules": {
  "priority": "BxR Red > Command Black/Graphite > Sector color > Command Brass > Functional",
  "brand_only_areas": [
   "Logo",
   "CTA buttons",
   "Reality Line",
   "Primary headline highlight"
  ],
  "sector_allowed": [
   "Labels/tags",
   "Kicker text (Deep on light, Light on dark)",
   "Chart series",
   "1–2 px borders and rules",
   "Block backgrounds ≤30% of layout",
   "Section dividers"
  ],
  "fire_vs_brand_red": "Rescue Vermilion is orange-shifted (ΔE2000 vs BxR Red ≥ 17). Never place a Vermilion block touching a BxR Red element; separate with Graphite/White; on Fire pages BxR Red is limited to Logo + CTA.",
  "navy_vs_police": "Maritime Blue is teal-leaning, Enforcement Indigo is violet-leaning (ΔE2000 ≥ 17). When shown together always add a text label; never rely on hue alone.",
  "all_five": "Fixed order Army → Navy → Air → Fire → Police; neutral ground (Graphite/White); equal weight; BxR Red only on the brand layer, never as a data series.",
  "disclaimer": "Sector colors are generic associative colors defined by Big x Reality for internal classification. They are not the official colors of any nation, military branch, fire service or police force."
 },
 "retired": {
  "Red Light #E8577A": "replaced by Command Brass (labels on dark) / BxR Red ≥24 px",
  "Red Deep as brand color": "now Text Red only",
  "Steel Blue #3D5A73": "replaced by Graphite / Brass",
  "Command Navy": "retired in v3.0",
  "Field Amber #D99A2B": "replaced by Signal Amber #E6B325",
  "RD reference background #213B54": "rendering artifact, never a brand color"
 }
}