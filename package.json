{
  "name": "bigxreality-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run assets",
    "prebuild": "node scripts/cms/check-source.mjs && npm run assets && node scripts/cms/pull-site.mjs",
    "assets": "node scripts/build-fonts.mjs && node scripts/make-favicons.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "qa:links": "node scripts/check-links.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:shots": "node scripts/qa-screenshots.mjs",
    "favicons": "node scripts/make-favicons.mjs",
    "qa:behaviour": "node scripts/qa-behaviour.mjs",
    "qa:header": "node scripts/qa-header.mjs",
    "qa:solutions": "node scripts/qa-solutions.mjs",
    "qa:company": "node scripts/qa-company.mjs",
    "qa:english": "node scripts/qa-english.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "cms:import": "node scripts/cms/import-markdown.mjs",
    "build:emdash": "BXR_CONTENT_SOURCE=emdash npm run build",
    "build:fixtures": "BXR_CONTENT_SOURCE=fixtures npm run build",
    "postbuild": "node scripts/build-search.mjs",
    "qa:search": "QA_DIST=dist-fixtures/client node scripts/qa-search.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "qa:phase2": "QA_DIST=dist-fixtures/client node scripts/qa-phase2.mjs",
    "preview:build": "BXR_PREVIEW=1 npm run build && node scripts/preview/rebase.mjs",
    "preview:check": "node scripts/preview/check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.1.0",
    "@cloudflare/kumo": "2.6.0",
    "@emdash-cms/cloudflare": "1.3.1",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource/b612-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "astro": "7.3.8",
    "bxr-cms": "file:plugins/bxr-cms",
    "emdash": "1.3.1",
    "github-slugger": "2.0.0",
    "kysely": "0.29.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "lighthouse": "13.5.0",
    "marked": "17.0.6",
    "pagefind": "1.5.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.2",
    "yaml": "2.9.1"
  },
  "emdash": {
    "seed": "seed/seed.json"
  }
}
