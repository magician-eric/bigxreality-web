---
/** A text-led cover, not a substitute photo. Uses only the article's confirmed metadata. */
interface Props { title:string; category:string; date?:Date }
const {title,category,date}=Astro.props;
---
<div class="editorial-cover" aria-hidden="true">
 <span class="category">{category}</span>
 <span class="headline">{title}</span>
 <span class="year">{date?.getUTCFullYear()}</span>
</div>
<style>
.editorial-cover { box-sizing:border-box; position:relative; display:flex; flex-direction:column; justify-content:center; gap:12px; width:100%; height:100%; aspect-ratio:16/9; padding:clamp(18px,3vw,36px); color:#fff; background:linear-gradient(125deg,#151d29,#0b0f14 72%); overflow:hidden; border-top:3px solid var(--bxr-red); }
.editorial-cover::after { content:'';position:absolute;right:-20px;bottom:-32px;width:140px;height:140px;border:1px solid rgb(255 255 255 / .12);transform:rotate(35deg); }
.category { color:#f3a9bc;font-size:12px;letter-spacing:.06em; }
.headline { font-size:clamp(14px,1.5vw,22px);line-height:1.55;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden; }
.year { color:#bac4d0;font-size:12px; }
</style>
