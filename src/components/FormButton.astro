---
/** Use a configured request form; otherwise route to the existing localized email inquiry flow. */
import { localePath, type Lang } from '../i18n';
import { formHref, type FormKind } from '../lib/site';
import { getUi } from '../lib/ui';
interface Props { kind: FormKind; lang: Lang; productCode?: string; variant: 'primary' | 'secondary' }
const {kind,lang,productCode,variant}=Astro.props;
const ui=getUi(lang), form=formHref(kind,productCode);
const query=new URLSearchParams({topic:kind==='brochure'?'info':'demo',...(productCode?{item:productCode}:{})});
const href=form??`${localePath(lang,'contact')}?${query}`;
---
<a class={`btn btn--${variant}`} href={href} target={form?'_blank':undefined} rel={form?'noopener':undefined}>{ui.buttons[kind]}{form&&<span class="visually-hidden">{ui.buttons.opensInNewTab}</span>}</a>
