---
/**
 * Dark page hero (DS P.16): breadcrumb, English label, H1, description, image on
 * the right, at most two buttons (passed in the "actions" slot).
 */
import ProductImage from './ProductImage.astro';
import type { ImageMetadata } from "astro";
import type { Crumb } from "./SeoHead.astro";
import Breadcrumb from "./Breadcrumb.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import Text from "./Text.astro";
import { distinctLabel } from "../lib/eyebrow";

interface Props {
  scenePosition?: string;
  sceneHeadroom?: number;
  sceneFit?: "cover" | "contain";
  variant?: "split" | "scene" | "equipment" | "interface";
  breadcrumbs: Crumb[];
  breadcrumbLabel: string;
  /** Short page-type label; left out when it repeats the kicker or H1. */
  eyebrow?: string;
  /** Line above the H1 (e.g. the product name when the H1 is a headline). */
  kicker?: string;
  title: string;
  subtitle?: string;
  /** Sub-headline: a full sentence under the H1 (landing pages). */
  lead?: string;
  description?: string;
  image?: { src: ImageMetadata; alt: string };
  imageCaption?: string;
  imagePending?: string;
  /** Label drawn bottom-right on illustrations (情境示意圖). */
  imageBadge?: string;
}
const { scenePosition = "60% 0%", sceneHeadroom = 24, sceneFit = "cover", variant = "split", breadcrumbs, breadcrumbLabel, eyebrow, kicker, title, subtitle, lead, description, image, imageCaption, imagePending, imageBadge } = Astro.props;
const label = distinctLabel(eyebrow, kicker, title);
const sub = distinctLabel(subtitle, kicker, title);
---
<section class:list={["page-hero", `hero--${variant}`]} data-theme="dark" data-hero-variant={variant} data-scene-fit={sceneFit} style={`--hero-scene-fit:${sceneFit};--hero-headroom:${sceneHeadroom}px;--hero-focus:${scenePosition}`}>
  <div class:list={["container", "grid", { "no-media": !image && !imagePending }]}>
    <div class="copy">
      <Breadcrumb items={breadcrumbs} label={breadcrumbLabel} />
      {label && <p class="t-label eyebrow">{label}</p>}
      {kicker && <p class="kicker t-h4"><Text value={kicker} /></p>}
      <h1 class="t-h1"><Text value={title} /></h1>
      {sub && <p class="subtitle"><Text value={sub} /></p>}
      {lead && <p class="lead"><Text value={lead} /></p>}
      {description && description.split(/\n\s*\n/).map((para) => <p class="desc"><Text value={para.trim()} /></p>)}
      {Astro.slots.has("actions") && <div class="actions"><slot name="actions" /></div>}
    </div>
    {(image || imagePending) && <figure class="media">
      {image ? (
        <ProductImage src={image.src} alt={image.alt} loading="eager" priority />
      ) : imagePending && <ImagePlaceholder label={imagePending} />}
      {image && imageBadge && <span class="badge t-caption">{imageBadge}</span>}
      {image && imageCaption && <figcaption class="t-tech"><Text value={imageCaption} /></figcaption>}
    </figure>}
  </div>
</section>
<style>
  .page-hero { padding-block: var(--section-py); }
  .grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--content-gap); align-items: center; }
  .no-media { grid-template-columns: minmax(0, 8fr) 4fr; }
  .copy { display: grid; gap: var(--space-3); align-content: start; }
  .eyebrow { color: var(--bxr-mist); margin-top: var(--space-3); }
  .kicker { color: var(--bxr-white); font-weight: 500; }
  .subtitle { color: var(--bxr-mist); font-size: var(--fs-h4); }
  .lead { color: var(--bxr-white); font-size: var(--fs-h4); line-height: var(--lh-h4); max-width: 36rem; }
  .desc { color: var(--ink-muted); max-width: 36rem; }
  .desc + .desc { margin-top: calc(-1 * var(--space-2)); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .media { position: relative; margin: 0; }
  .media :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .badge {
    position: absolute; right: var(--space-2); bottom: var(--space-2); padding: 2px var(--space-1);
    background: rgb(10 12 16 / 0.72); color: var(--bxr-white); line-height: 1.5; pointer-events: none;
  }
  figcaption { position: absolute; right: var(--space-2); bottom: var(--space-1); color: var(--bxr-mist); }
  @media (max-width: 1023px) { .grid { grid-template-columns: 1fr; } .page-hero { padding-block: var(--section-py); } }
</style>

<style>
.hero--equipment .grid,.hero--interface .grid { grid-template-columns: minmax(0,4fr) minmax(0,6fr); }
.hero--equipment .media :global(img),.hero--interface .media :global(img) { aspect-ratio: auto; max-height: 480px; object-fit: contain !important; }
.hero--interface .grid { grid-template-columns: minmax(0,3.5fr) minmax(0,6.5fr); }
.hero--scene { min-height: 520px; position: relative; isolation: isolate; overflow: hidden; display: grid; align-items: center; }
.hero--scene .grid { display: block; }
.hero--scene .copy { position: relative; z-index: 2; max-width: 46%; }
.hero--scene .media { position: absolute; inset: 0; width: 100%; z-index: 0; }
.hero--scene .media :global(img) { height: 100%; width: 100%; object-fit: var(--hero-scene-fit, cover) !important; object-position: var(--hero-focus) !important; aspect-ratio: auto; }
.hero--scene::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg,rgb(11 15 20 / .97) 0%,rgb(11 15 20 / .9) 24%,rgb(11 15 20 / .58) 43%,rgb(11 15 20 / .12) 65%,rgb(11 15 20 / .35) 86%,rgb(11 15 20 / .82) 100%),linear-gradient(180deg,rgb(11 15 20 / .15),transparent 35%,transparent 75%,rgb(11 15 20 / .48)); }
@media(max-width:1023px) { .hero--equipment .grid,.hero--interface .grid { grid-template-columns: 1fr; } }
@media(max-width:1023px) { .hero--scene { min-height: 0; padding-bottom: 0; } .hero--scene::before { display: none; } .hero--scene .grid { display: grid; } .hero--scene .copy { max-width: 100%; } .hero--scene .media { position: relative; inset: auto; width: 100%; padding: 0; } .hero--scene .media :global(img) { height: auto; aspect-ratio: 3/2; object-fit: contain !important; } }
</style>

<style>.no-media { grid-template-columns: 1fr; } .no-media .copy,.no-media .desc { max-width: var(--reading-width); }</style>

<style>
@media(min-width:1024px) {
 /* Blend the actual image edges, not a separate rectangular panel. */
 .hero--scene[data-scene-fit="contain"] .media :global(img) { position: absolute; right: 0; top: var(--hero-headroom); height: calc(100% - var(--hero-headroom)); width: auto; max-width: 88%; object-fit: contain !important; mask-image: linear-gradient(90deg,transparent,black 16%,black 84%,transparent),linear-gradient(180deg,transparent,black 7%,black 94%,transparent); mask-composite: intersect; }
}
</style>
