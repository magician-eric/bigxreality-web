---
/** Application scenarios: title, description and a "training focus" line. */
import Text from "./Text.astro";
interface Props { items: { title: string; description: string; focus?: string }[]; focusLabel: string }
const { items, focusLabel } = Astro.props;
---
<ul role="list" class="scenarios">
  {items.map((s, i) => (
    <li class="scenario">
      <span class="num t-tech" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <div class="body">
        <h3 class="t-h4"><Text value={s.title} /></h3>
        <p class="desc"><Text value={s.description} /></p>
      </div>
      {s.focus && <p class="focus t-small"><span class="t-label"><Text value={focusLabel} /></span><Text value={s.focus} /></p>}
    </li>
  ))}
</ul>
<style>
  .scenarios { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--bxr-black); }
  .scenario { display: grid; grid-template-columns: 56px minmax(0, 6fr) minmax(0, 4fr); gap: var(--space-3); align-items: start; padding: var(--space-4) 0; border-bottom: 1px solid var(--bxr-line); }
  .num { color: var(--ink-muted); padding-top: 4px; }
  .body { display: grid; gap: var(--space-1); }
  .desc { margin: 0; color: var(--ink-muted); }
  .focus { display: grid; gap: 4px; margin: 0; padding: var(--space-2); background: var(--bxr-paper); }
  :global(.section--alt) .focus { background: var(--bxr-white); }
  .focus .t-label { color: var(--ink-muted); }
  @media (max-width: 1023px) { .scenario { grid-template-columns: 44px 1fr; } .focus { grid-column: 2; } }
</style>
