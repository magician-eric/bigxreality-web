---
/**
 * Application scenarios as picture cards: 16:9 image on top, then title, scenario
 * description and the training focus. Desktop: a 6-column grid that lays 3 + 2 (or any
 * count) evenly; phone: one column.
 */
import type { ImageMetadata } from "astro";
import MediaSlot from "./MediaSlot.astro";
import Text from "./Text.astro";

type Slot = { src?: ImageMetadata; alt?: string; need?: string; caption?: string; ratio?: string };
interface Props {
  items: { title: string; description: string; focus?: string; image?: Slot }[];
  focusLabel: string;
  needPrefix: string;
  badge?: string;
  fallbackLabel: string;
}
const { items, focusLabel, needPrefix, fallbackLabel, badge } = Astro.props;
---
<ul role="list" class="scenarios" style={`--per: ${items.length === 4 ? 2 : 3}`}>
  {items.map((s) => (
    <li class="card">
      {s.image && <MediaSlot media={s.image} ratio="16 / 9" fallbackLabel={fallbackLabel} needPrefix={needPrefix} badge={badge} sizes="(max-width: 767px) 100vw, 33vw" />}
      <div class="body">
        <h3 class="t-h4"><Text value={s.title} /></h3>
        <p class="desc"><Text value={s.description} /></p>
        {s.focus && <p class="focus t-small"><span class="t-label"><Text value={focusLabel} /></span><Text value={s.focus} /></p>}
      </div>
    </li>
  ))}
</ul>
<style>
  /* Equal-size cards, 3 per row (2 per row for exactly four); an incomplete last row is centred. */
  .scenarios { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .card { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gutter)) / var(--per)); display: flex; flex-direction: column; background: var(--bxr-white); border: 1px solid var(--bxr-line); }
  .body { display: grid; gap: var(--space-1); align-content: start; flex: 1; padding: var(--space-3); }
  .desc { margin: 0; color: var(--ink-muted); }
  .focus { display: grid; gap: 4px; margin: var(--space-1) 0 0; padding: var(--space-2); background: var(--bxr-paper); color: var(--ink-muted); margin-top: auto; }
  .focus .t-label { color: var(--ink); }
  @media (max-width: 1023px) { .card { flex-basis: calc((100% - var(--gutter)) / 2); } }
  @media (max-width: 767px) { .card { flex-basis: 100%; } }
</style>
