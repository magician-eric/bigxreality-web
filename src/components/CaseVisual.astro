---
/**
 * Representative picture of a case at 16:9. Without a picture it shows a quiet CIS block
 * (no text, no "missing" wording) so the layout is identical before and after the photo is added.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { cover?: { src: ImageMetadata; alt: string }; sizes?: string; eager?: boolean }
const { cover, sizes = "(max-width: 767px) 100vw, 400px", eager = false } = Astro.props;
---
<div class="visual">
  {cover ? (
    <Picture
      src={cover.src} alt={cover.alt} formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600].filter((w) => w <= cover.src.width)} sizes={sizes}
      width={1280} height={720} fit="cover" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined}
    />
  ) : (
    <div class="blank" aria-hidden="true"><span class="mark"></span></div>
  )}
</div>
<style>
  .visual { aspect-ratio: 16 / 9; overflow: hidden; background: var(--bxr-paper); }
  .visual :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .blank {
    position: relative; width: 100%; height: 100%;
    background:
      linear-gradient(var(--bxr-line) 1px, transparent 1px) 0 0 / 100% 25%,
      linear-gradient(90deg, var(--bxr-line) 1px, transparent 1px) 0 0 / 12.5% 100%,
      var(--bxr-paper);
  }
  .mark { position: absolute; left: var(--space-3); bottom: var(--space-3); width: 12px; height: 12px; background: var(--bxr-red); }
  :global([data-theme="dark"]) .blank { background: var(--bxr-graphite); }
</style>
