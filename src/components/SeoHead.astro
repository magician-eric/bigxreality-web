---
import { publicUrl } from '../lib/public-url.ts';

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { DEFAULT_LANG, HREFLANG, LANGS, OG_LOCALE, HTML_LANG, type Lang } from "../i18n";
import { site, companyName } from "../lib/site";
import { isEditorialPlaceholder, isPending } from "../lib/pending";
import { plain } from "../lib/text";
import { indexablePages } from "../lib/indexable-pages";
import { seoTitle } from "../lib/seo-title";

export interface Crumb { name: string; path: string }
export interface ProductLd { name: string; description: string; code?: string }
/** Article metadata: og:type=article tags. */
export interface ArticleMeta { published?: Date; modified?: Date; tags: string[] }

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page with the language segment replaced by `{lang}`, e.g. `/{lang}/products/sut/` */
  pathTemplate: string;
  /** Languages in which this page exists. */
  alternates: Lang[];
  noindex?: boolean;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  breadcrumbs: Crumb[];
  product?: ProductLd;
  article?: ArticleMeta;
  /** Extra schema.org nodes (Article, CollectionPage, …); `[待…]` text must already be removed. */
  structuredData?: Record<string, unknown>[];
}

const { lang, title, description, pathTemplate, alternates, noindex = false, ogImage, ogImageAlt, breadcrumbs, product, article, structuredData = [] } = Astro.props;
const abs = (path: string) => publicUrl(path).toString();
const pathFor = (l: Lang) => pathTemplate.replace("{lang}", l);
const canonical = abs(pathFor(lang));
const fullTitle = seoTitle(title);
const indexable = await indexablePages();
const seoAlternates = noindex ? [] : alternates.filter(l => indexable.some(p => p.lang === l && p.path === pathTemplate));
const desc = plain(description);

// Only the page's own image with this language's approved alt; [待提供]／[待翻譯] keeps the site fallback.
const approvedImage = ogImage && ogImageAlt?.trim() && !isEditorialPlaceholder(ogImageAlt) ? ogImage : undefined;
const og = approvedImage
  ? abs((await getImage({ src: approvedImage, width: 1200, height: 630, fit: "cover", format: "jpg" })).src)
  : abs("/icon-512.png");

const org: Record<string, unknown> = {
  "@type": "Organization",
  "@id": `${site.url}/#organization`,
  name: site.brand,
  url: `${site.url}/`,
  logo: abs("/icon-512.png"),
  slogan: site.tagline,
};
if (!isPending(companyName(lang))) org.legalName = companyName(lang);
if (!isPending(site.contact.email)) org.email = site.contact.email;
if (!isPending(site.contact.phone)) org.telephone = site.contact.phone;
if (Array.isArray(site.social) && site.social.length) org.sameAs = site.social.map((s) => s.url);

const graph: Record<string, unknown>[] = [org];
// An untranslated crumb ("[待翻譯] …") would put another language's text into this page's data; leave the list out until it is translated.
if (!breadcrumbs.some((c) => c.name.includes("[待"))) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: plain(c.name), item: abs(c.path) })),
  });
}
if (product) {
  const p: Record<string, unknown> = {
    "@type": "Product",
    name: plain(product.name),
    ...(product.code ? { sku: product.code } : {}),
    brand: { "@id": `${site.url}/#organization` },
    url: canonical,
  };
  // JSON-LD never carries placeholder text.
  if (!product.description.includes("[待")) p.description = plain(product.description);
  // Same 1200×630 file as og:image; no page image, no schema image.
  if (approvedImage) p.image = og;
  graph.push(p);
}
const principal = structuredData.some(node => ["WebPage", "CollectionPage", "Article", "NewsArticle"].includes(String(node["@type"])));
if (!product && !principal) graph.push({ "@type": /\/(products|solutions|technologies|news|insights|cases|tags)\/(?:page\/\d+\/)?$/.test(pathFor(lang)) ? "CollectionPage" : "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: fullTitle, description: desc, inLanguage: HTML_LANG[lang] });
// Page-level nodes share the page language, and list/web pages fall back to the meta description.
for (const node of structuredData) {
  const type = String(node["@type"]);
  if (!["WebPage", "CollectionPage", "Article", "NewsArticle"].includes(type)) continue;
  node.inLanguage ??= HTML_LANG[lang];
  // An untranslated heading ("[待翻譯] …") is not this page's language; url and description still identify the page.
  if (typeof node.name === "string" && node.name.includes("[待")) delete node.name;
  if (type === "WebPage" || type === "CollectionPage") node.description ??= desc;
  // Articles carry the same 1200×630 file as og:image, or no image.
  if (type === "Article" || type === "NewsArticle") {
    if (approvedImage) node.image = og;
    else delete node.image;
  }
}
graph.push(...structuredData);
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{seoAlternates.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(pathFor(l))} />)}
{seoAlternates.includes(DEFAULT_LANG) && <link rel="alternate" hreflang="x-default" href={abs(pathFor(DEFAULT_LANG))} />}
<meta property="og:type" content={product ? "product" : article ? "article" : "website"} />
{article?.published && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{article?.tags.map((t) => <meta property="article:tag" content={plain(t)} />)}
<meta property="og:site_name" content={site.brand} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LANGS.filter((l) => l !== lang && seoAlternates.includes(l)).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
<meta property="og:image" content={og} />
{approvedImage && <meta property="og:image:width" content="1200" />}
{approvedImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={approvedImage && ogImageAlt ? plain(ogImageAlt) : site.brand} />
<meta name="twitter:card" content={approvedImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={og} />
<meta name="twitter:image:alt" content={approvedImage && ogImageAlt ? plain(ogImageAlt) : site.brand} />
<script type="application/ld+json" set:html={jsonLd} />
