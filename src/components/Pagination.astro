---
/** Numbered pagination for article lists. Page 1 is the list URL itself (no /page/1/). */
import { localePath, type Lang } from "../i18n";
import { getUi, format } from "../lib/ui";
import Text from "./Text.astro";
interface Props { lang: Lang; base: string; current: number; total: number }
const { lang, base, current, total } = Astro.props;
const ui = getUi(lang);
const href = (n: number) => (n === 1 ? localePath(lang, base) : localePath(lang, base, "page", String(n)));
---
{total > 1 && (
  <nav class="pagination" aria-label={ui.listing.pagination}>
    <ul role="list">
      <li>{current > 1 ? <a href={href(current - 1)} rel="prev"><Text value={ui.listing.previous} /></a> : <span class="off" aria-hidden="true"><Text value={ui.listing.previous} /></span>}</li>
      {Array.from({ length: total }, (_, i) => i + 1).map((n) => (
        <li>
          {n === current
            ? <span class="num current" aria-current="page"><span class="visually-hidden"><Text value={format(ui.listing.pageOf, { n, total })} /></span><span aria-hidden="true">{n}</span></span>
            : <a class="num" href={href(n)}><span class="visually-hidden"><Text value={format(ui.listing.page, { n })} /></span><span aria-hidden="true">{n}</span></a>}
        </li>
      ))}
      <li>{current < total ? <a href={href(current + 1)} rel="next"><Text value={ui.listing.next} /></a> : <span class="off" aria-hidden="true"><Text value={ui.listing.next} /></span>}</li>
    </ul>
  </nav>
)}
<style>
  .pagination { margin-top: var(--space-8); }
  ul { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-1); margin: 0; padding: 0; list-style: none; }
  a, span.num, .off { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding-inline: var(--space-2); font-family: var(--font-mono); font-size: var(--fs-small); }
  a { color: var(--ink); border: 1px solid var(--bxr-ash); text-decoration: none; }
  a:hover { border-color: var(--bxr-black); }
  .current { background: var(--bxr-black); color: var(--bxr-white); }
  .off { color: var(--ink-muted); }
</style>
