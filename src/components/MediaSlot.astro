---
/**
 * One image position on a landing page. With a photo it renders the optimised picture;
 * without one it shows a CIS placeholder that names the material needed, at the final
 * ratio, so photos can be dropped in later without moving anything.
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Text from "./Text.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  media?: { src?: ImageMetadata; alt?: string; need?: string; caption?: string };
  /** CSS aspect ratio, e.g. "16 / 9". */
  ratio: string;
  /** Label of the placeholder when the slot has no `need`. */
  fallbackLabel: string;
  /** Text before the material description on the placeholder. */
  needPrefix: string;
  sizes?: string;
  eager?: boolean;
}
const { media, ratio, fallbackLabel, needPrefix, sizes = "(max-width: 767px) 100vw, 50vw", eager = false } = Astro.props;
const ready = media?.src && media.alt;
const label = media?.need ? `${needPrefix}${media.need}` : fallbackLabel;
---
<figure class="media" style={`--ratio: ${ratio}`}>
  {ready ? (
    <Picture
      src={media!.src!} alt={media!.alt!} formats={["avif", "webp"]}
      widths={[480, 800, 1200, 1600].filter((w) => w <= media!.src!.width)} sizes={sizes}
      fit="cover" loading={eager ? "eager" : "lazy"}
    />
  ) : (
    <ImagePlaceholder label={label} ratio={ratio} />
  )}
  {media?.caption && <figcaption class="t-caption"><Text value={media.caption} /></figcaption>}
</figure>
<style>
  .media { margin: 0; }
  .media :global(img) { display: block; width: 100%; height: auto; aspect-ratio: var(--ratio); object-fit: cover; }
  figcaption { margin-top: var(--space-1); color: var(--ink-muted); }
</style>
