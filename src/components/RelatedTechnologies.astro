---
/** Reverse subject links use the same relation map as the technology detail pages. */
import type { Lang } from "../i18n";
import { technologyRelations } from "../data/technology-relations";
import { LIVE_TECHNOLOGY_IDS, technologyHref, technologyName } from "../lib/technologies";
interface Props { lang: Lang; collection: "products" | "solutions"; slug: string }
const { lang, collection, slug } = Astro.props;
const related = LIVE_TECHNOLOGY_IDS.filter((id) => (technologyRelations[id][collection] as readonly string[]).includes(slug));
const copy = {
  tw: { title: "相關核心技術", description: "探索相關技術主題與應用領域。這些連結不代表本產品或解決方案具備各技術頁提及的全部功能；實際能力以正式產品資料及專案配置為準。" },
  en: { title: "Related Core Technologies", description: "Explore related technology topics and application areas. These links do not mean that this product or solution implements every capability discussed on each technology page. Actual capabilities depend on the product information and project configuration." },
  jp: { title: "関連するコア技術", description: "関連する技術テーマと活用分野をご紹介します。これらのリンクは、本製品またはソリューションが各技術ページで触れるすべての機能を備えていることを意味しません。実際の機能は、正式な製品情報とプロジェクトの構成に基づきます。" },
};
---
{related.length > 0 && <section class="section related-technologies" aria-labelledby="h-related-technologies" data-related-technologies>
  <div class="container">
    <h2 class="t-h2" id="h-related-technologies">{copy[lang].title}</h2>
    <p class="description">{copy[lang].description}</p>
    <ul role="list">{related.map((id) => <li><a href={technologyHref(id, lang)}>{technologyName(id, lang)} <span aria-hidden="true">↗</span></a></li>)}</ul>
  </div>
</section>}
<style>
  .related-technologies { border-top: 1px solid var(--divider); }
  .description { max-width: 52rem; color: var(--ink-muted); margin-block: var(--space-2) var(--space-4); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; }
</style>
