---
/**
 * /[lang]/cases/ — the success-case overview. Cards come from the published, client-approved
 * case studies; the filters are built from what those cases use. With no published case the
 * page still opens with a plain empty state (no invented cases) and is noindex.
 */
import { getEntry } from "astro:content";
import { LANGS, localePath, type Lang } from "../i18n";
import { getCases } from "../lib/cases";
import { getArticles, articleHref } from "../lib/articles";
import { isEditorialPlaceholder as isPending } from "../lib/pending";
import { getUi } from "../lib/ui";
import { plain } from "../lib/text";
import { site } from "../lib/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import CaseList from "./CaseList.astro";
import CtaBand from "./CtaBand.astro";
import Text from "./Text.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = getUi(lang);
const c = ui.cases;
const copy = (await getEntry("pages", `${lang}/case-studies`))!.data;
const cases = await getCases(lang);
const alternates: Lang[] = [];
for (const l of LANGS) if ((await getArticles("case-studies", l)).length > 0) alternates.push(l);

const breadcrumbs = [
  { name: ui.home, path: localePath(lang) },
  { name: ui.nav.caseStudies, path: localePath(lang, "case-studies") },
];
const abs = (p: string) => new URL(p, site.url).toString();
const collectionLd = {
  "@type": "CollectionPage",
  name: plain(copy.hero.title),
  url: abs(localePath(lang, "case-studies")),
  mainEntity: { "@type": "ItemList", itemListElement: cases.map((x, i) => ({ "@type": "ListItem", position: i + 1, url: abs(articleHref(x.article)) })) },
};
---
<BaseLayout
  lang={lang} title={copy.seo.title} description={copy.seo.description} pathTemplate="/{lang}/cases/" alternates={alternates}
  pendingTranslation={copy.translationStatus === "pending"} noindex={cases.length === 0}
  headerTheme="dark" current="resources" currentResource="case-studies" fallbackPath="/{lang}/cases/" breadcrumbs={breadcrumbs}
  structuredData={cases.length ? [collectionLd] : []}
>
  <PageHero breadcrumbs={breadcrumbs} breadcrumbLabel={ui.breadcrumbLabel} eyebrow={copy.hero.eyebrow} title={isPending(copy.hero.title)?ui.nav.caseStudies:copy.hero.title} lead={copy.hero.lead && !isPending(copy.hero.lead)?copy.hero.lead:undefined} description={copy.hero.description && !isPending(copy.hero.description)?copy.hero.description:undefined} />
  <section class="section" aria-labelledby="h-case-list">
    <div class="container">
      <h2 id="h-case-list" class="visually-hidden"><Text value={isPending(copy.hero.title)?ui.nav.caseStudies:copy.hero.title} /></h2>
      {cases.length === 0 ? (
        <div class="empty" role="status" data-case-empty>
          <p class="t-h4"><Text value={c.empty} /></p>
          <p class="t-muted"><Text value={c.emptyHint} /></p>
          <a class="btn btn--secondary" href={localePath(lang, "contact")}><Text value={c.emptyCta} /></a>
        </div>
      ) : (
        <CaseList lang={lang} cases={cases} />
      )}
    </div>
  </section>
  {cases.length > 0 && (
    <CtaBand id="list-cta" title={c.cta.title} description={c.cta.description}>
      <a class="btn btn--primary" href={localePath(lang, "contact")}><Text value={c.cta.button} /></a>
    </CtaBand>
  )}
</BaseLayout>
<style>
  .empty { display: grid; gap: var(--space-2); justify-items: start; padding: var(--space-8) var(--space-5); border: 1px solid var(--bxr-line); background: var(--bxr-paper); }
  .empty p { margin: 0; }
  @media (max-width: 767px) { .empty { padding: var(--space-5) var(--space-3); } }
</style>
