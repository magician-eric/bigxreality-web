---
/**
 * Site footer. The link columns are the Header menu itself: one column per top-level item of
 * src/lib/navigation.ts, with its submenu items below, so the Footer never keeps its own list.
 * Contact details, social links and the company name come from site settings (src/lib/site.ts).
 * Social links appear only once real URLs are set; planned pages show as plain text.
 */
import { localePath, type Lang } from "../i18n";
import { getUi } from "../lib/ui";
import { navigation, legalLinks } from "../lib/navigation";
import { site, companyName, phoneDisplay, phoneHref } from "../lib/site";
import { isPending } from "../lib/pending";
import Logo from "./Logo.astro";
import Text from "./Text.astro";

interface Props { lang: Lang; hidePending?: boolean }
const { lang, hidePending = false } = Astro.props;
const ui = getUi(lang);
const year = new Date().getFullYear();
const columns = navigation(lang);
const legal = legalLinks(lang);
const { contact } = site;
const tel = phoneHref();
const social = Array.isArray(site.social) ? site.social : [];
const show = (value: string) => !hidePending || (!!value.trim() && !isPending(value));
const hasContact = [contact.address[lang], contact.phone, contact.email].some(show) || social.length > 0;
const holder = isPending(companyName(lang)) ? site.brand : companyName(lang);
---
<footer class="site-footer" data-theme="dark">
  <div class="container top">
    <div class="brand">
      <a href={localePath(lang)} aria-label={ui.logoHome} class="logo"><Logo theme="dark" /></a>
      <p class="tagline">{site.tagline}</p>
    </div>

    {hasContact && <section class="contact" aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="t-label"><Text value={ui.footer.contactHeading} /></h2>
      <dl>
        {show(contact.address[lang]) && <div><dt><Text value={ui.footer.address} /></dt><dd>
          {isPending(contact.mapUrl) || isPending(contact.address[lang])
            ? <Text value={contact.address[lang]} />
            : <a href={contact.mapUrl} target="_blank" rel="noopener noreferrer"><Text value={contact.address[lang]} /><span class="visually-hidden"> <Text value={ui.footer.mapLink} /><Text value={ui.buttons.opensInNewTab} /></span></a>}
        </dd></div>}
        {show(contact.phone) && <div><dt><Text value={ui.footer.phone} /></dt><dd>{tel ? <a href={tel}>{phoneDisplay(lang)}</a> : <Text value={contact.phone} />}</dd></div>}
        {show(contact.email) && <div><dt><Text value={ui.footer.email} /></dt><dd>{isPending(contact.email) ? <Text value={contact.email} /> : <a href={`mailto:${contact.email}`}>{contact.email}</a>}</dd></div>}
      </dl>
      {social.length > 0 && (
        <ul role="list" class="social" aria-label={ui.footer.social}>
          {social.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}<span class="visually-hidden"><Text value={ui.buttons.opensInNewTab} /></span></a></li>)}
        </ul>
      )}
    </section>}
  </div>

  <nav class="container cols" aria-label={ui.footer.navLabel}>
    {columns.map((col) => (
      <div class="col">
        <h2 class="t-label col-head">
          {col.href ? <a href={col.href}><Text value={col.label} /></a> : <span class:list={{ "is-planned": col.children.length === 0 }}><Text value={col.label} />{col.children.length === 0 && <span class="visually-hidden"> <Text value={ui.nav.planned} /></span>}</span>}
        </h2>
        {col.children.length > 0 && (
          <ul role="list" class="links">
            {col.children.map((l) => (
              <li>{l.href ? <a href={l.href}><Text value={l.label} /></a> : <span class="is-planned"><Text value={l.label} /><span class="visually-hidden"> <Text value={ui.nav.planned} /></span></span>}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </nav>

  <div class="container legal t-caption">
    <p>© {year} <Text value={holder} /> <Text value={ui.footer.rights} /></p>
    {legal.some((l) => l.href) && (
      <ul role="list" class="legal-links">
        {legal.filter((l) => l.href).map((l) => <li><a href={l.href!}><Text value={l.label} /></a></li>)}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer { background: var(--surface); color: var(--ink); padding-block: var(--space-10) var(--space-5); }
  .top { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-6); }
  .logo { display: inline-flex; }
  .tagline { margin-top: var(--space-2); color: var(--ink-muted); }
  h2 { color: var(--bxr-mist); margin-bottom: var(--space-2); }
  dl { display: grid; gap: var(--space-1); margin: 0; }
  dl div { display: grid; grid-template-columns: 6em 1fr; gap: var(--space-2); }
  dt { color: var(--ink-muted); }
  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  dd a { color: var(--ink); display: inline-block; min-height: 24px; }
  .social { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); margin: var(--space-3) 0 0; padding: 0; }
  .social a { display: inline-flex; align-items: center; min-height: 32px; color: var(--ink); }
  .cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-5) var(--space-4);
    margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--divider);
  }
  .col-head a { color: var(--ink); text-decoration: none; }
  .col-head a:hover { text-decoration: underline; }
  .links { display: grid; gap: var(--space-1); margin: 0; padding: 0; }
  .links a, .links span { display: inline-flex; min-height: 32px; align-items: center; color: var(--ink); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .col-head .is-planned, .links .is-planned { color: var(--ink-muted); }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2);
    margin-top: var(--space-8); padding-top: var(--space-3); border-top: 1px solid var(--divider); color: var(--ink-muted);
  }
  .legal p { margin: 0; }
  .legal-links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: 0; padding: 0; }
  .legal a { color: var(--ink); min-height: 24px; display: inline-flex; align-items: center; }
  @media (max-width: 1023px) { .top { grid-template-columns: 1fr; } }
  @media (max-width: 767px) {
    .cols { grid-template-columns: 1fr 1fr; }
    dl div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
