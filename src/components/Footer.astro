---
import { localePath, type Lang } from "../i18n";
import { getUi } from "../lib/ui";
import { site, companyName } from "../lib/site";
import { isPending } from "../lib/pending";
import Logo from "./Logo.astro";
import Text from "./Text.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = getUi(lang);
const year = new Date().getFullYear();
const links = [
  { label: ui.nav.solutions, href: localePath(lang, "solutions") },
  { label: ui.nav.products, href: localePath(lang, "products") },
  { label: ui.nav.technologies, href: localePath(lang, "technologies") },
  { label: ui.nav.news, href: localePath(lang, "news") },
  { label: ui.nav.insights, href: localePath(lang, "insights") },
  { label: ui.nav.caseStudies, href: localePath(lang, "case-studies") },
  { label: ui.nav.company, href: localePath(lang, "company") },
  { label: ui.contact, href: localePath(lang, "contact") },
];
const { contact } = site;
---
<footer class="site-footer" data-theme="dark">
  <div class="container grid">
    <div class="brand">
      <a href={localePath(lang)} aria-label={ui.logoHome} class="logo"><Logo theme="dark" /></a>
      <p class="tagline">{site.tagline}</p>
    </div>

    <nav aria-label={ui.footer.navLabel}>
      <ul role="list" class="links">
        {links.map((l) => <li><a href={l.href}><Text value={l.label} /></a></li>)}
        <li>
          {isPending(site.careersUrl)
            ? <span><Text value={ui.footer.careers} /> <mark class="pending">[待提供]</mark></span>
            : <a href={site.careersUrl} rel="noopener" target="_blank"><Text value={ui.footer.careers} /><span class="visually-hidden"><Text value={ui.buttons.opensInNewTab} /></span></a>}
        </li>
      </ul>
    </nav>

    <section class="contact" aria-labelledby="footer-contact">
      <h2 id="footer-contact" class="t-label"><Text value={ui.footer.contactHeading} /></h2>
      <dl>
        <div><dt><Text value={ui.footer.address} /></dt><dd><Text value={contact.address[lang]} /></dd></div>
        <div><dt><Text value={ui.footer.phone} /></dt><dd>{isPending(contact.phone) ? <Text value={contact.phone} /> : <a href={`tel:${contact.phone.replace(/[^+\d]/g, "")}`}>{contact.phone}</a>}</dd></div>
        <div><dt><Text value={ui.footer.email} /></dt><dd>{isPending(contact.email) ? <Text value={contact.email} /> : <a href={`mailto:${contact.email}`}>{contact.email}</a>}</dd></div>
        <div><dt><Text value={ui.footer.social} /></dt><dd>
          {Array.isArray(site.social)
            ? site.social.map((s) => <a href={s.url} rel="noopener" target="_blank">{s.label}</a>)
            : <Text value={site.social} />}
        </dd></div>
      </dl>
    </section>
  </div>
  <div class="container legal t-caption">
    <p>© {year} <Text value={companyName(lang)} /> <Text value={ui.footer.rights} /></p>
    <a href={localePath(lang, "privacy")}><Text value={ui.footer.privacy} /></a>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface); color: var(--ink); padding-block: var(--space-10) var(--space-5); }
  .grid { display: grid; grid-template-columns: 4fr 3fr 5fr; gap: var(--space-6); }
  .logo { display: inline-flex; }
  .tagline { margin-top: var(--space-2); color: var(--ink-muted); }
  .links { display: grid; gap: var(--space-1); margin: 0; padding: 0; }
  .links a, .links span { display: inline-flex; min-height: 32px; align-items: center; color: var(--ink); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  h2 { color: var(--bxr-mist); margin-bottom: var(--space-2); }
  dl { display: grid; gap: var(--space-1); margin: 0; }
  dl div { display: grid; grid-template-columns: 6em 1fr; gap: var(--space-2); }
  dt { color: var(--ink-muted); }
  dd { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2);
    margin-top: var(--space-8); padding-top: var(--space-3); border-top: 1px solid var(--divider); color: var(--ink-muted);
  }
  .legal a { color: var(--ink); min-height: 24px; display: inline-flex; align-items: center; }
  @media (max-width: 1023px) { .grid { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; } }
</style>
