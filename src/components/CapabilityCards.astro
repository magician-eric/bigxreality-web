---
/** Capabilities: title, what it is, and the training value in a tinted footer. Any number of items. */
import Text from "./Text.astro";
interface Props { items: { title: string; content: string; value?: string }[]; valueLabel: string }
const { items, valueLabel } = Astro.props;
---
<ul role="list" class="caps">
  {items.map((c, i) => (
    <li class="cap">
      <div class="head"><span class="num t-tech" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3 class="t-h4"><Text value={c.title} /></h3></div>
      <p class="content"><Text value={c.content} /></p>
      {c.value && <p class="value t-small"><span class="t-label"><Text value={valueLabel} /></span><Text value={c.value} /></p>}
    </li>
  ))}
</ul>
<style>
  .caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .cap { display: flex; flex-direction: column; background: var(--bxr-white); border: 1px solid var(--bxr-line); border-top: 2px solid var(--bxr-black); }
  .cap:first-child:nth-last-child(odd) { grid-column: 1 / -1; }
  .head { display: flex; align-items: baseline; gap: var(--space-2); padding: var(--space-3) var(--space-3) 0; }
  .num { color: var(--ink-muted); }
  .content { margin: 0; padding: var(--space-2) var(--space-3) var(--space-3); flex: 1; }
  .value { display: grid; gap: 4px; margin: 0; padding: var(--space-2) var(--space-3); background: var(--bxr-paper); border-top: 1px solid var(--bxr-line); color: var(--ink-muted); }
  .value .t-label { color: var(--ink); }
  @media (max-width: 767px) { .caps { grid-template-columns: 1fr; } }
</style>
