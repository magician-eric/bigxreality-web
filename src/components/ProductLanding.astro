---
/**
 * Product sales landing page, shared by every product that has a `landing` block
 * (src/content.config.ts). Sections appear only when the product has their data, in
 * this order: hero (+CTA) → training challenge → approach (+ pillars, showcase image) →
 * capabilities → training flow → scenarios → adoption values → related products and
 * solutions → closing CTA. Backgrounds and layouts alternate so the page does not read
 * as one repeated grid. Images are placeholders until the approved photos are supplied.
 * The hero and closing band share one CTA definition (lib/cta.ts).
 */
import type { CollectionEntry } from "astro:content";
import { localePath, type Lang } from "../i18n";
import { availableLangs, getLocalized } from "../lib/content";
import { ctaSet } from "../lib/cta";
import { isPending } from "../lib/pending";
import { getUi } from "../lib/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import SectionHead from "./SectionHead.astro";
import CardProduct from "./CardProduct.astro";
import CardSolution from "./CardSolution.astro";
import CtaBand from "./CtaBand.astro";
import CtaGroup from "./CtaGroup.astro";
import RelatedCases from "./RelatedCases.astro";
import LandingSections from "./LandingSections.astro";
import { alternatingSections } from "../lib/landing";
import { casesAbout } from "../lib/cases";
import Text from "./Text.astro";

interface Props {
  lang: Lang;
  slug: string;
  base: CollectionEntry<"products">["data"];
  data: CollectionEntry<"products">["data"];
  pendingTranslation: boolean;
}
const { lang, slug, base, data: d, pendingTranslation } = Astro.props;
const L = d.landing!;
const ui = getUi(lang);
const t = ui.productLanding;
const e = t.eyebrows;
const cta = ctaSet(lang, { page: "productInquiry", code: base.hero.code ?? d.hero.name, label: L.ctaLabel });
const need = t.mediaNeed;
const badge = t.illustrationLabel;
const hero = L.heroImage;
const heroReady = hero?.src && hero.alt;

// Related products / solutions: only entries that have a built page in this language.
// Confirmed integrations (either direction) come first, then the products this one lists
// as "related" (a pointer to look at next, not an integration).
const allProducts = await getLocalized("products", lang);
const integrated = allProducts.filter(
  (p) => p.slug !== slug && ((base.integratedOps?.products ?? []).includes(p.slug) || (p.base.data.integratedOps?.products ?? []).includes(slug)),
);
const listed = allProducts.filter((p) => p.slug !== slug && (base.relatedProducts ?? []).includes(p.slug) && !integrated.includes(p));
const relatedProducts = [...integrated, ...listed];
const relatedSolutions = (await getLocalized("solutions", lang)).filter((s) => (base.relatedSolutions ?? []).includes(s.slug));
// Fields still holding the [待提供] marker are left off the cards instead of being shown.
const known = (v?: string) => (v && !isPending(v) ? v : undefined);
const showRelated = !!L.related && (relatedProducts.length > 0 || relatedSolutions.length > 0);

const breadcrumbs = [
  { name: ui.home, path: localePath(lang) },
  { name: ui.nav.products, path: localePath(lang, "products") },
  { name: d.hero.name, path: localePath(lang, "products", slug) },
];
// background rhythm: sections alternate white / tinted in the order they appear
// Published, client-approved cases that point at this product (hidden when there are none).
const cases = await casesAbout("relatedProducts", slug, lang);
let n = alternatingSections(L);
const alt = () => (n++ % 2 === 1 ? "section section--alt" : "section");
---
<BaseLayout
  lang={lang}
  title={d.seo?.title ?? d.hero.name}
  description={d.seo?.description ?? L.subheadline}
  pathTemplate={`/{lang}/products/${slug}/`}
  alternates={await availableLangs("products", slug)}
  pendingTranslation={pendingTranslation}
  headerTheme="dark"
  current="products"
  breadcrumbs={breadcrumbs}
  search={{ type: "products" }}
  product={{ name: d.hero.name, description: d.seo?.description ?? L.subheadline, code: base.hero.code }}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={ui.breadcrumbLabel}
    eyebrow={base.hero.code ? `Product · ${base.hero.code}` : "Product"}
    kicker={d.hero.name}
    title={L.headline}
    lead={L.subheadline}
    description={L.intro}
    image={heroReady ? { src: hero!.src!, alt: hero!.alt! } : undefined}
    imageCaption={hero?.caption}
    imageBadge={hero?.illustration ? badge : undefined}
    imagePending={hero?.need ? `${need}${hero.need}` : t.placeholders.hero}
  >
    <CtaGroup slot="actions" actions={cta.hero} />
  </PageHero>

  <LandingSections lang={lang} L={L} />

  <!-- Applied cases: relations are stored on the case; nothing renders without a published case -->
  <RelatedCases lang={lang} cases={cases} description={L.casesIntro} alt={cases.length > 0 && n++ % 2 === 1} />

  <!-- Related products and solutions (only entries with a real page) -->
  {showRelated && (
    <section class={alt()} aria-labelledby="h-related">
      <div class="container">
        <SectionHead id="h-related" eyebrow={e.related} title={L.related!.title} description={L.related!.intro} />
        <ul role="list" class="cards">
          {relatedProducts.map((p) => (
            <li>
              <CardProduct
                lang={lang} href={localePath(lang, "products", p.slug)} name={p.loc.data.hero.name}
                englishName={known(p.loc.data.hero.englishName)} summary={known(p.loc.data.summary) ?? known(p.loc.data.hero.tagline)}
                domains={p.base.data.domains}
                image={p.base.data.hero.image && { src: p.base.data.hero.image.src, alt: p.loc.data.hero.image?.alt ?? p.base.data.hero.image.alt }}
              />
            </li>
          ))}
          {relatedSolutions.map((s) => (
            <li>
              <CardSolution
                lang={lang} href={localePath(lang, "solutions", s.slug)} domain={s.base.data.domain}
                name={s.loc.data.name} englishName={s.loc.data.englishName} summary={s.loc.data.summary}
                image={s.base.data.image && { src: s.base.data.image.src, alt: s.loc.data.image?.alt ?? s.base.data.image.alt }}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand id="product-cta" title={L.closing.title} description={L.closing.description}>
    <CtaGroup actions={cta.footer} />
  </CtaBand>
</BaseLayout>
