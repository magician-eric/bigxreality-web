---
/**
 * Product sales landing page, shared by every product that has a `landing` block
 * (src/content.config.ts). Sections appear only when the product has their data, in
 * this order: hero (+CTA) → training challenge → approach (+ pillars, showcase image) →
 * capabilities → training flow → scenarios → adoption values → related products and
 * solutions → closing CTA. Backgrounds and layouts alternate so the page does not read
 * as one repeated grid. Images are placeholders until the approved photos are supplied.
 * The hero and closing band share one CTA definition (lib/cta.ts).
 */
import type { CollectionEntry } from "astro:content";
import { localePath, type Lang } from "../i18n";
import { availableLangs, getLocalized } from "../lib/content";
import { ctaSet } from "../lib/cta";
import { isPending } from "../lib/pending";
import { getUi } from "../lib/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import SectionHead from "./SectionHead.astro";
import ChallengeCards from "./ChallengeCards.astro";
import PillarGrid from "./PillarGrid.astro";
import CapabilityShowcase from "./CapabilityShowcase.astro";
import MediaSlot from "./MediaSlot.astro";
import FlowSteps from "./FlowSteps.astro";
import ScenarioCards from "./ScenarioCards.astro";
import ValueCards from "./ValueCards.astro";
import CardProduct from "./CardProduct.astro";
import CardSolution from "./CardSolution.astro";
import CtaBand from "./CtaBand.astro";
import CtaGroup from "./CtaGroup.astro";
import RelatedCases from "./RelatedCases.astro";
import { casesAbout } from "../lib/cases";
import Text from "./Text.astro";

interface Props {
  lang: Lang;
  slug: string;
  base: CollectionEntry<"products">["data"];
  data: CollectionEntry<"products">["data"];
  pendingTranslation: boolean;
}
const { lang, slug, base, data: d, pendingTranslation } = Astro.props;
const L = d.landing!;
const ui = getUi(lang);
const t = ui.productLanding;
const e = t.eyebrows;
const cta = ctaSet(lang, { page: "productInquiry", code: base.hero.code ?? d.hero.name, label: L.ctaLabel });
const need = t.mediaNeed;
const badge = t.illustrationLabel;
const pending = t.mediaPending;
const hero = L.heroImage;
const heroReady = hero?.src && hero.alt;
const images = L.approach?.images ?? [];
const paras = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

// Related products / solutions: only entries that have a built page in this language.
// Confirmed integrations (either direction) come first, then the products this one lists
// as "related" (a pointer to look at next, not an integration).
const allProducts = await getLocalized("products", lang);
const integrated = allProducts.filter(
  (p) => p.slug !== slug && ((base.integratedOps?.products ?? []).includes(p.slug) || (p.base.data.integratedOps?.products ?? []).includes(slug)),
);
const listed = allProducts.filter((p) => p.slug !== slug && (base.relatedProducts ?? []).includes(p.slug) && !integrated.includes(p));
const relatedProducts = [...integrated, ...listed];
const relatedSolutions = (await getLocalized("solutions", lang)).filter((s) => (base.relatedSolutions ?? []).includes(s.slug));
// Fields still holding the [待提供] marker are left off the cards instead of being shown.
const known = (v?: string) => (v && !isPending(v) ? v : undefined);
const showRelated = !!L.related && (relatedProducts.length > 0 || relatedSolutions.length > 0);

const breadcrumbs = [
  { name: ui.home, path: localePath(lang) },
  { name: ui.nav.products, path: localePath(lang, "products") },
  { name: d.hero.name, path: localePath(lang, "products", slug) },
];
// background rhythm: sections alternate white / tinted in the order they appear
// Published, client-approved cases that point at this product (hidden when there are none).
const cases = await casesAbout("relatedProducts", slug, lang);
let n = 0;
const alt = () => (n++ % 2 === 1 ? "section section--alt" : "section");
---
<BaseLayout
  lang={lang}
  title={d.seo?.title ?? d.hero.name}
  description={d.seo?.description ?? L.subheadline}
  pathTemplate={`/{lang}/products/${slug}/`}
  alternates={await availableLangs("products", slug)}
  pendingTranslation={pendingTranslation}
  headerTheme="dark"
  current="products"
  breadcrumbs={breadcrumbs}
  search={{ type: "products" }}
  product={{ name: d.hero.name, description: d.seo?.description ?? L.subheadline, code: base.hero.code }}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={ui.breadcrumbLabel}
    eyebrow={base.hero.code ? `Product · ${base.hero.code}` : "Product"}
    kicker={d.hero.name}
    title={L.headline}
    lead={L.subheadline}
    description={L.intro}
    image={heroReady ? { src: hero!.src!, alt: hero!.alt! } : undefined}
    imageCaption={hero?.caption}
    imageBadge={hero?.illustration ? badge : undefined}
    imagePending={hero?.need ? `${need}${hero.need}` : t.placeholders.hero}
  >
    <CtaGroup slot="actions" actions={cta.hero} />
  </PageHero>

  <!-- Training challenge: heading and introduction beside the numbered problems -->
  {L.challenge && (
    <section class={alt()} aria-labelledby="h-challenge">
      <div class="container">
        <div class="challenge">
          <div class="challenge-head">
            <SectionHead id="h-challenge" eyebrow={e.challenge} title={L.challenge.title} />
            {L.challenge.intro && <div class="prose">{paras(L.challenge.intro).map((p) => <p><Text value={p} /></p>)}</div>}
          </div>
          <ChallengeCards items={L.challenge.cards} columns={1} />
        </div>
        {L.challenge.note && <p class="note"><Text value={L.challenge.note} /></p>}
      </div>
    </section>
  )}

  <!-- Approach: text beside a physical-training + virtual-scene image pair, then the value pillars -->
  {L.approach && (
    <section class={alt()} aria-labelledby="h-approach">
      <div class="container">
        <div class:list={["split", { solo: images.length === 0 }]}>
          <div class="copy">
            <SectionHead id="h-approach" eyebrow={e.approach} title={L.approach.title} />
            {L.approach.intro && <div class="prose">{paras(L.approach.intro).map((p) => <p><Text value={p} /></p>)}</div>}
          </div>
          {images.length > 0 && (
            <div class:list={["pair", { single: images.length === 1, stack: images[0]?.ratio === "16 / 9" }]}>
              {images.map((img, i) => (
                <>
                  {i === 1 && <span class="link" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 11h16M13 5l6 6-6 6" /></svg></span>}
                  <MediaSlot media={img} ratio={images.length === 1 ? "4 / 3" : "4 / 5"} fallbackLabel={pending} needPrefix={need} badge={badge} sizes="(max-width: 767px) 50vw, 28vw" />
                </>
              ))}
            </div>
          )}
        </div>
        {L.approach.pillars && <div class="after"><PillarGrid items={L.approach.pillars} /></div>}
      </div>
    </section>
  )}

  <!-- Capabilities -->
  {L.capabilities && (
    <section class={alt()} aria-labelledby="h-capabilities">
      <div class="container">
        <SectionHead id="h-capabilities" eyebrow={e.capabilities} title={L.capabilities.title} description={L.capabilities.intro} />
        <CapabilityShowcase items={L.capabilities.items} valueLabel={t.valueLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
      </div>
    </section>
  )}

  <!-- Training flow -->
  {L.flow && (
    <section class={alt()} aria-labelledby="h-flow">
      <div class="container">
        <SectionHead id="h-flow" eyebrow={e.flow} title={L.flow.title} description={L.flow.intro} />
        <FlowSteps steps={L.flow.steps} stepLabel={t.stepLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
        {L.flow.note && <p class="note t-small"><Text value={L.flow.note} /></p>}
      </div>
    </section>
  )}

  <!-- Scenarios -->
  {L.scenarios && (
    <section class={alt()} aria-labelledby="h-scenarios">
      <div class="container">
        <SectionHead id="h-scenarios" eyebrow={e.scenarios} title={L.scenarios.title} description={L.scenarios.intro} />
        <ScenarioCards items={L.scenarios.items} focusLabel={t.focusLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
      </div>
    </section>
  )}

  <!-- Adoption value (dark band for rhythm) -->
  {L.values && (
    <section class="section" data-theme="dark" aria-labelledby="h-values">
      <div class="container">
        <SectionHead id="h-values" eyebrow={e.values} title={L.values.title} description={L.values.intro} />
        <ValueCards items={L.values.cards} />
        {L.values.note && <p class="note closing"><Text value={L.values.note} /></p>}
      </div>
    </section>
  )}

  <!-- Applied cases: relations are stored on the case; nothing renders without a published case -->
  <RelatedCases lang={lang} cases={cases} description={L.casesIntro} alt={cases.length > 0 && n++ % 2 === 1} />

  <!-- Related products and solutions (only entries with a real page) -->
  {showRelated && (
    <section class={alt()} aria-labelledby="h-related">
      <div class="container">
        <SectionHead id="h-related" eyebrow={e.related} title={L.related!.title} description={L.related!.intro} />
        <ul role="list" class="cards">
          {relatedProducts.map((p) => (
            <li>
              <CardProduct
                lang={lang} href={localePath(lang, "products", p.slug)} name={p.loc.data.hero.name}
                englishName={known(p.loc.data.hero.englishName)} summary={known(p.loc.data.summary) ?? known(p.loc.data.hero.tagline)}
                domains={p.base.data.domains}
                image={p.base.data.hero.image && { src: p.base.data.hero.image.src, alt: p.loc.data.hero.image?.alt ?? p.base.data.hero.image.alt }}
              />
            </li>
          ))}
          {relatedSolutions.map((s) => (
            <li>
              <CardSolution
                lang={lang} href={localePath(lang, "solutions", s.slug)} domain={s.base.data.domain}
                name={s.loc.data.name} englishName={s.loc.data.englishName} summary={s.loc.data.summary}
                image={s.base.data.image && { src: s.base.data.image.src, alt: s.loc.data.image?.alt ?? s.base.data.image.alt }}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand id="product-cta" title={L.closing.title} description={L.closing.description}>
    <CtaGroup actions={cta.footer} />
  </CtaBand>
</BaseLayout>

<style>
  .challenge { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .challenge-head { display: grid; gap: var(--space-4); align-content: start; position: sticky; top: calc(var(--header-h) + var(--space-4)); }
  .challenge-head :global(.section-head) { margin-bottom: 0; }
  .split { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .split.solo { grid-template-columns: 1fr; }
  .pair.single, .pair.stack { grid-template-columns: 1fr; }
  .pair.stack .link svg { transform: rotate(90deg); }
  .pair { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .link { position: absolute; left: 50%; top: 50%; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; transform: translate(-50%, -50%); background: var(--bxr-black); color: var(--bxr-white); border-bottom: 2px solid var(--bxr-red); }
  .copy { display: grid; gap: var(--space-4); align-content: start; }
  .copy :global(.section-head) { margin-bottom: 0; }
  .prose { display: grid; gap: var(--space-2); max-width: 44rem; }
  .prose p { margin: 0; }
  .after { margin-top: var(--space-8); }
  .note { margin: var(--space-5) 0 0; max-width: 48rem; color: var(--ink-muted); padding-left: var(--space-2); border-left: 2px solid var(--bxr-red); }
  .note.closing { color: var(--ink); font-size: var(--fs-h4); line-height: var(--lh-h4); max-width: 64rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 1023px) { .split, .challenge { grid-template-columns: 1fr; gap: var(--space-4); } .challenge-head { position: static; } .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .cards { grid-template-columns: 1fr; } }
</style>
