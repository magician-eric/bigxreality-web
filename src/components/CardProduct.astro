---
/**
 * Product card (DS P.13): square corners, 1 px Line border, 16:9 image.
 * Hover: title turns Text Red, image scales to 1.02 over 400 ms.
 * The whole card is clickable through the title link (stretched link).
 */
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../i18n";
import type { ProductDomain } from "../lib/domains";
import { getUi } from "../lib/ui";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import SectorTag from "./SectorTag.astro";
import Text from "./Text.astro";

interface Props {
  lang: Lang;
  href: string;
  name: string;
  englishName?: string;
  summary?: string;
  /** Product categories (lib/domains.ts PRODUCT_DOMAINS). */
  domains: ProductDomain[];
  /** Tag names; the products overview passes ui.productDomains, other pages keep ui.domains. */
  domainLabels?: Partial<Record<ProductDomain, string>>;
  image?: { src: ImageMetadata; alt: string };
  headingLevel?: 2 | 3;
}
const { lang, href, name, englishName, summary, domains, domainLabels, image, headingLevel = 3 } = Astro.props;
const ui = getUi(lang);
const H = `h${headingLevel}` as "h2" | "h3";
---
<article data-interactive-card class="card">
  <div class="media">
    {image
      ? <Picture src={image.src} alt={image.alt} formats={["avif", "webp"]} widths={[400, 640, 960, 1280].filter((w) => w <= image.src.width)} sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 400px" width={640} height={360} fit="cover" />
      : <ImagePlaceholder label={ui.imagePending} />}
  </div>
  <div class="body">
    <ul role="list" class="tags">{domains.map((d) => <li><SectorTag domain={d} lang={lang} label={domainLabels?.[d]} /></li>)}</ul>
    <H class="t-h4 title"><a href={href}><Text value={name} /></a></H>
    {englishName && <p class="t-tech english"><Text value={englishName} /></p>}
    {summary && <p class="t-small summary"><Text value={summary} /></p>}
  </div>
</article>
<style>
  .card { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--divider); background: var(--surface); }
  .media { overflow: hidden; aspect-ratio: 16 / 9; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-standard) var(--ease-precise); }
  .card:hover .media :global(img) { transform: scale(1.02); }
  .body { display: grid; gap: var(--space-1); padding: var(--card-padding); align-content: start; }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0 0 var(--space-1); padding: 0; list-style: none; }
  .title a { color: var(--ink); text-decoration: none; transition: color var(--dur-micro) var(--ease-precise); }
  .title a::after { content: ""; position: absolute; inset: 0; }
  .card:hover .title a { color: var(--bxr-text-red); }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .english { color: var(--ink-muted); }
  .summary { color: var(--ink-muted); margin-top: var(--space-1); }
  .tags :global(li) { position: relative; z-index: 1; }
  .media:has(:global(.placeholder)) { aspect-ratio: auto; height: auto; }
</style>
