---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Lang } from "../i18n";
import { getUi } from "../lib/ui";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import Text from "./Text.astro";

type Domain = "military" | "police" | "fire-rescue" | "smart-city";
interface Props { lang: Lang; href: string; domain: Domain; name: string; englishName: string; summary: string; image?: { src: ImageMetadata; alt: string }; label?: string; headline?: string }
const { lang, href, domain, name, englishName, summary, image, label, headline } = Astro.props;
const ui = getUi(lang);
---
<article class={`card sector--${domain}`}>
  <div class="media">
    {image
      ? <Picture src={image.src} alt={image.alt} formats={["avif", "webp"]} widths={[400, 640, 960]} sizes="(max-width: 767px) 100vw, 400px" width={640} height={360} fit="cover" />
      : <ImagePlaceholder label={ui.solutionImagePending} />}
  </div>
  <div class="body">
    <p class="t-label code"><span class="dot" aria-hidden="true"></span>{ui.domainCodes[domain]}</p>
    <h3 class="t-h4 title"><a href={href}><Text value={name} /></a></h3>
    <p class="t-tech english"><Text value={headline ?? englishName} /></p>
    <p class="t-small summary"><Text value={summary} /></p>
    {label && <p class="more" aria-hidden="true"><Text value={label} /> →</p>}
  </div>
</article>
<style>
  .more { margin: var(--space-2) 0 0; font-weight: 500; color: var(--ink); }
  .card:hover .more { color: var(--bxr-text-red); }
  .card { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--divider); background: var(--surface); }
  .media { overflow: hidden; aspect-ratio: 16 / 9; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-standard) var(--ease-precise); }
  .card:hover .media :global(img) { transform: scale(1.02); }
  .body { display: grid; gap: var(--space-1); padding: var(--space-3); }
  .code { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--sector-color); }
  .dot { width: 8px; height: 8px; background: var(--sector-color); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a::after { content: ""; position: absolute; inset: 0; }
  .card:hover .title a { color: var(--bxr-text-red); }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .english, .summary { color: var(--ink-muted); }
</style>
