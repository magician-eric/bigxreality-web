---
import ProductImage from './ProductImage.astro';
import { primaryImage } from '../data/primary-images';
import type { ImageMetadata } from "astro";
import type { Lang } from "../i18n";
import { getUi } from "../lib/ui";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import Text from "./Text.astro";

type Domain = "military" | "police" | "fire-rescue" | "smart-city";
interface Props { lang: Lang; href: string; domain: Domain; name: string; summary: string; image?: { src: ImageMetadata; alt: string }; label?: string; headline?: string; headingLevel?: 2 | 3 }
const { lang, href, domain, name, summary, image, label, headline, headingLevel = 3 } = Astro.props;
const H = `h${headingLevel}` as "h2" | "h3";
const ui = getUi(lang);
const resolvedImage = primaryImage('solutions', href.match(/\/solutions\/([^/?#]+)/)?.[1] ?? '', lang) ?? image;
// One name per card, in the page language: the English name and the domain code only repeated it.
// The sector colour is carried by the left border (approved card design).
const subtitle = headline;
---
<article data-interactive-card class={`card sector--${domain}`}>
  <div class="media">
    {resolvedImage
      ? <ProductImage src={resolvedImage.src} alt={resolvedImage.alt} />
      : <ImagePlaceholder label={ui.solutionImagePending} />}
  </div>
  <div class="body">
    <H class="t-h4 title"><a href={href}><Text value={name} /></a></H>
    {subtitle && <p class="t-tech english"><Text value={subtitle} /></p>}
    <p class="t-small summary"><Text value={summary} /></p>
    {label && <p class="more" aria-hidden="true"><Text value={label} /> →</p>}
  </div>
</article>
<style>
  .more { margin: var(--space-2) 0 0; font-weight: 500; color: var(--ink); }
  .card:hover .more { color: var(--bxr-text-red); }
  .card { position: relative; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--divider); border-left: 3px solid var(--sector-color); background: var(--surface); }
  .media { overflow: hidden; aspect-ratio: 16 / 9; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-standard) var(--ease-precise); }
  .card:hover .media :global(img) { transform: scale(1.02); }
  .body { display: grid; gap: var(--space-1); padding: var(--card-padding); }
  .title a { color: var(--ink); text-decoration: none; }
  .title a::after { content: ""; position: absolute; inset: 0; }
  .card:hover .title a { color: var(--bxr-text-red); }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
  .english, .summary { color: var(--ink-muted); }
  .media:has(:global(.placeholder)) { aspect-ratio: auto; height: auto; }
</style>

<style>.body { display: flex; flex-direction: column; flex: 1; } .summary { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; } .more { margin-top: auto; padding-top: var(--space-2); }</style>
