---
/** Adoption value: short cards with a top rule and a check mark. */
import Text from "./Text.astro";
interface Props { items: { title: string; description: string }[] }
const { items } = Astro.props;
---
<ul role="list" class="values" style={`--cols: ${items.length === 3 ? 3 : 2}`}>
  {items.map((v) => (
    <li class="value">
      <svg class="check" width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 10.5l4 4 8-9" /></svg>
      <h3 class="t-h4"><Text value={v.title} /></h3>
      <p class="t-muted"><Text value={v.description} /></p>
    </li>
  ))}
</ul>
<style>
  .values { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .value { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-3) 0 0; border-top: 2px solid var(--ink); }
  .check { color: var(--bxr-red); }
  .value p { margin: 0; }
  @media (max-width: 767px) { .values { grid-template-columns: 1fr; } }
</style>
