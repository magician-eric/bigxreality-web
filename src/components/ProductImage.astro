---
/** Native asset URL from Astro's local import; no source rewriting or extra image conversion.
 * Fixed parent frames own the display ratio; contain is reserved for subjects that cannot be cropped.
 */
import type { ImageMetadata } from 'astro';
import { imagePresentation } from '../data/primary-images';
interface Props { src: ImageMetadata; alt: string; loading?: 'eager' | 'lazy'; priority?: boolean }
const { src, alt, loading = 'lazy', priority = false } = Astro.props;
const presentation = imagePresentation(src);
---
<img src={src.src} alt={alt} width={src.width} height={src.height} loading={loading} decoding="async"
  fetchpriority={priority ? 'high' : undefined}
  style={`object-fit:${presentation.fit};object-position:${presentation.position}`}
  data-primary-image={presentation.file} />
