---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imagePresentation } from '../data/primary-images';
/** sizes: the slot's real rendered width per breakpoint; the default fits a three-column card grid. */
interface Props { src:ImageMetadata;alt:string;loading?:'eager'|'lazy';priority?:boolean;showType?:boolean;sizes?:string }
const {src,alt,loading='lazy',priority=false,showType=true,sizes='(max-width: 767px) calc(100vw - 32px), (max-width: 1023px) 50vw, 384px'}=Astro.props;
const presentation=imagePresentation(src);
const typeLabel=({tw:"概念視覺",en:"Concept visual",jp:"コンセプトビジュアル"} as Record<string,string>)[Astro.params.lang??"en"]??"Concept visual";
// avif/webp sources; the original format stays the <img> fallback. No width above the original is generated.
const widths=[320,480,640,800,1024,1280,1600].filter(w=>w<src.width).concat(src.width);
const fallbackFormat=src.format==='jpg'?'jpeg':src.format;
---
<span class="asset-frame">
 <Picture src={src} alt={alt} formats={['avif','webp']} fallbackFormat={fallbackFormat} widths={widths} sizes={sizes} width={src.width} height={src.height}
  loading={loading} decoding="async" fetchpriority={priority?'high':undefined}
  style={`object-fit:${presentation.fit};object-position:${presentation.position}`} data-primary-image={presentation.file} />
 {showType && presentation.illustration && <span class="asset-kind">{typeLabel}</span>}
</span>
<style>
.asset-frame { display:block;position:relative;isolation:isolate;width:100%;height:100%;overflow:hidden;background:#0b0f14; }
.asset-frame::before { content:'';position:absolute;inset:-20px;z-index:-1;background-image:var(--asset-backdrop);background-size:cover;background-position:center;filter:blur(18px);opacity:.3; }
.asset-kind { position:absolute;right:8px;bottom:8px;z-index:2;padding:3px 7px;font-size:11px;line-height:1.5;color:white;background:rgb(11 15 20 / .8); }
.asset-frame :global(picture) { display:contents; }
.asset-frame :global(img) { display:block;width:100%;height:100%;position:relative; }
</style>

<script>
  // Reuse the decoded, browser-cached image for its extension; preserve native lazy loading.
  // currentSrc is the responsive candidate the browser picked, so the blurred backdrop never fetches the original.
  function initializeImageBackgrounds() {
    document.querySelectorAll<HTMLImageElement>('.asset-frame > picture > img').forEach(img => {
      if(img.dataset.backdropReady)return;
      img.dataset.backdropReady='true';
      const setBackground=()=>img.closest<HTMLElement>('.asset-frame')?.style.setProperty('--asset-backdrop',`url("${img.currentSrc||img.src}")`);
      if(img.complete&&img.naturalWidth)setBackground();else img.addEventListener('load',setBackground,{once:true});
    });
  }
  initializeImageBackgrounds();
  document.addEventListener('astro:page-load',initializeImageBackgrounds);
</script>
