---
/**
 * The body of a landing page (products and solutions): training challenge → approach (+ pillars) →
 * capabilities → featured items → training flow → scenarios → audience → adoption values.
 * Sections appear only when the page has their data; backgrounds alternate white / tinted in the
 * order they appear (`sectionCount` tells the caller how many alternating sections were rendered).
 * Images are placeholders until approved photos are supplied.
 */
import { localePath, type Lang } from "../i18n";
import { getLocalized } from "../lib/content";
import { getUi } from "../lib/ui";
import SectionHead from "./SectionHead.astro";
import ChallengeCards from "./ChallengeCards.astro";
import PillarGrid from "./PillarGrid.astro";
import CapabilityShowcase from "./CapabilityShowcase.astro";
import MediaSlot from "./MediaSlot.astro";
import FlowSteps from "./FlowSteps.astro";
import ScenarioCards from "./ScenarioCards.astro";
import ValueCards from "./ValueCards.astro";
import Text from "./Text.astro";

interface Props { lang: Lang; L: any }
const { lang, L } = Astro.props;
const ui = getUi(lang);
const t = ui.productLanding;
const e = t.eyebrows;
const need = t.mediaNeed;
const badge = t.illustrationLabel;
const pending = t.mediaPending;
const images = L.approach?.images ?? [];
const paras = (s: string) => s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
// Featured items link to a solution page only when it exists in this language.
const needsLinks = !!L.featured || (L.blocks ?? []).some((b: any) => b.kind === "featured");
const solutions = needsLinks ? await getLocalized("solutions", lang) : [];
const products = needsLinks ? await getLocalized("products", lang) : [];
let n = 0;
const alt = () => (n++ % 2 === 1 ? "section section--alt" : "section");
---
  <!-- Training challenge: heading and introduction beside the numbered problems -->
  {L.challenge && (
    <section class={alt()} aria-labelledby="h-challenge">
      <div class="container">
        <div class="challenge">
          <div class="challenge-head">
            <SectionHead id="h-challenge" eyebrow={e.challenge} title={L.challenge.title} />
            {L.challenge.intro && <div class="prose">{paras(L.challenge.intro).map((p) => <p><Text value={p} /></p>)}</div>}
          </div>
          <ChallengeCards items={L.challenge.cards} columns={1} />
        </div>
        {L.challenge.note && <p class="note"><Text value={L.challenge.note} /></p>}
      </div>
    </section>
  )}

  <!-- Approach: text beside a physical-training + virtual-scene image pair, then the value pillars -->
  {L.approach && (
    <section class={alt()} aria-labelledby="h-approach">
      <div class="container">
        <div class:list={["split", { solo: images.length === 0, wide: images.length === 3 }]}>
          <div class="copy">
            <SectionHead id="h-approach" eyebrow={e.approach} title={L.approach.title} />
            {L.approach.intro && <div class="prose">{paras(L.approach.intro).map((p) => <p><Text value={p} /></p>)}</div>}
          </div>
          {images.length > 0 && (
            <div class:list={["pair", { single: images.length === 1, triple: images.length === 3, stack: images.length < 3 && images[0]?.ratio === "16 / 9" }]}>
              {images.map((img: any, i: number) => (
                <>
                  {i === 1 && images.length === 2 && <span class="link" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 11h16M13 5l6 6-6 6" /></svg></span>}
                  <MediaSlot media={img} ratio={images.length === 1 || images.length === 3 ? "4 / 3" : "4 / 5"} fallbackLabel={pending} needPrefix={need} badge={badge} sizes="(max-width: 767px) 50vw, 28vw" />
                </>
              ))}
            </div>
          )}
        </div>
        {L.approach.pillars && <div class="after"><PillarGrid items={L.approach.pillars} /></div>}
      </div>
    </section>
  )}

  <!-- Capabilities -->
  {L.capabilities && (
    <section class={alt()} aria-labelledby="h-capabilities">
      <div class="container">
        <SectionHead id="h-capabilities" eyebrow={e.capabilities} title={L.capabilities.title} description={L.capabilities.intro} />
        <CapabilityShowcase items={L.capabilities.items} valueLabel={t.valueLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
      </div>
    </section>
  )}

  <!-- Featured items: side-by-side cards (no hierarchy implied) -->
  {L.featured && (
    <section class={alt()} aria-labelledby="h-featured">
      <div class="container">
        <SectionHead id="h-featured" eyebrow={e.featured} title={L.featured.title} description={L.featured.intro} />
        <ul role="list" class="featured">
          {L.featured.items.map((it: any) => {
            const target = solutions.find((x) => x.slug === it.solution);
            return (
              <li class="feat">
                <h3 class="t-h3"><Text value={it.title} /></h3>
                <div class="prose">{paras(it.description).map((p: string) => <p><Text value={p} /></p>)}</div>
                {target && <a class="btn btn--secondary" href={localePath(lang, "solutions", it.solution)}><Text value={it.ctaLabel} /></a>}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Training flow -->
  {L.flow && (
    <section class={alt()} aria-labelledby="h-flow">
      <div class="container">
        <SectionHead id="h-flow" eyebrow={e.flow} title={L.flow.title} description={L.flow.intro} />
        <FlowSteps steps={L.flow.steps} stepLabel={t.stepLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
        {L.flow.note && <p class="note t-small"><Text value={L.flow.note} /></p>}
      </div>
    </section>
  )}

  <!-- Scenarios -->
  {L.scenarios && (
    <section class={alt()} aria-labelledby="h-scenarios">
      <div class="container">
        <SectionHead id="h-scenarios" eyebrow={e.scenarios} title={L.scenarios.title} description={L.scenarios.intro} />
        <ScenarioCards items={L.scenarios.items} focusLabel={t.focusLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />
      </div>
    </section>
  )}

  <!-- Audience: who the training suits -->
  {L.audience && (
    <section class={alt()} aria-labelledby="h-audience">
      <div class="container">
        <SectionHead id="h-audience" eyebrow={e.audience} title={L.audience.title} description={L.audience.intro} />
        <ValueCards items={L.audience.cards} />
        {L.audience.note && <p class="note t-small"><Text value={L.audience.note} /></p>}
      </div>
    </section>
  )}

  <!-- Free-form blocks (prose / list / checks / featured), in the order given -->
  {(L.blocks ?? []).map((b: any, i: number) => (
    <section class={alt()} aria-labelledby={`h-block-${i}`}>
      <div class="container">
        {b.kind === "prose" ? (
          <div class="pb">
            <div class="pb-head">
              {b.eyebrow && <p class="t-label eyebrow"><Text value={b.eyebrow} /></p>}
              <h2 class="t-h2" id={`h-block-${i}`}><Text value={b.title} /></h2>
            </div>
            <div class="prose">{paras(b.body ?? "").map((p: string) => <p><Text value={p} /></p>)}</div>
          </div>
        ) : (
          <>
            <SectionHead id={`h-block-${i}`} eyebrow={b.eyebrow ?? ""} title={b.title} description={b.intro} />
            {b.kind === "list" && <CapabilityShowcase items={(b.items ?? []).map((x: any) => ({ title: x.title, content: x.content ?? "" }))} valueLabel={t.valueLabel} needPrefix={need} fallbackLabel={pending} badge={badge} />}
            {b.kind === "checks" && <ValueCards items={(b.items ?? []).map((x: any) => ({ title: x.title, description: x.content }))} />}
            {b.kind === "featured" && (
              <ul role="list" class="featured">
                {(b.items ?? []).map((it: any) => {
                  const href = it.solution && solutions.some((x) => x.slug === it.solution) ? localePath(lang, "solutions", it.solution) : it.product && products.some((x) => x.slug === it.product) ? localePath(lang, "products", it.product) : undefined;
                  return (
                    <li class="feat">
                      <h3 class="t-h3"><Text value={it.title} /></h3>
                      <div class="prose">{paras(it.content ?? "").map((p: string) => <p><Text value={p} /></p>)}</div>
                      {href && it.cta && <a class="btn btn--secondary" href={href}><Text value={it.cta} /></a>}
                    </li>
                  );
                })}
              </ul>
            )}
          </>
        )}
      </div>
    </section>
  ))}

  <!-- Adoption value (dark band for rhythm) -->
  {L.values && (
    <section class="section" data-theme="dark" aria-labelledby="h-values">
      <div class="container">
        <SectionHead id="h-values" eyebrow={e.values} title={L.values.title} description={L.values.intro} />
        <ValueCards items={L.values.cards} />
        {L.values.note && <p class="note closing"><Text value={L.values.note} /></p>}
      </div>
    </section>
  )}



<style>
  .pb { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .pb-head { display: grid; gap: var(--space-2); align-content: start; }
  .pb-head h2, .pb-head .eyebrow { margin: 0; }
  .pb-head .eyebrow { color: var(--ink-muted); }

  .featured { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .feat { display: grid; gap: var(--space-3); align-content: start; justify-items: start; padding: var(--space-4); border: 1px solid var(--divider); border-top: 2px solid var(--ink); background: var(--surface); }
  .feat h3, .feat .prose { margin: 0; }

  .challenge { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .challenge-head { display: grid; gap: var(--space-4); align-content: start; position: sticky; top: calc(var(--header-h) + var(--space-4)); }
  .challenge-head :global(.section-head) { margin-bottom: 0; }
  .split { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .split.solo, .split.wide { grid-template-columns: 1fr; }
  .pair.triple { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .pair.single, .pair.stack { grid-template-columns: 1fr; }
  .pair.stack .link svg { transform: rotate(90deg); }
  .pair { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  .link { position: absolute; left: 50%; top: 50%; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; transform: translate(-50%, -50%); background: var(--bxr-black); color: var(--bxr-white); border-bottom: 2px solid var(--bxr-red); }
  .copy { display: grid; gap: var(--space-4); align-content: start; }
  .copy :global(.section-head) { margin-bottom: 0; }
  .prose { display: grid; gap: var(--space-2); max-width: 44rem; }
  .prose p { margin: 0; }
  .after { margin-top: var(--space-8); }
  .note { margin: var(--space-5) 0 0; max-width: 48rem; color: var(--ink-muted); padding-left: var(--space-2); border-left: 2px solid var(--bxr-red); }
  .note.closing { color: var(--ink); font-size: var(--fs-h4); line-height: var(--lh-h4); max-width: 64rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 1023px) { .pb { grid-template-columns: 1fr; gap: var(--space-3); } .split, .challenge { grid-template-columns: 1fr; gap: var(--space-4); } .challenge-head { position: static; } .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .cards, .pair.triple, .featured { grid-template-columns: 1fr; } }
</style>
