---
/**
 * Process with visual guidance: each step has a round icon on a connecting line, an
 * optional picture, a step label, title and text. Desktop: one row; tablet and phone:
 * a vertical line with the icon on the left. For a suggested process, not a software procedure.
 */
import type { ImageMetadata } from "astro";
import FlowIcon from "./FlowIcon.astro";
import MediaSlot from "./MediaSlot.astro";
import Text from "./Text.astro";

type Slot = { src?: ImageMetadata; alt?: string; need?: string; caption?: string };
interface Props {
  steps: { title: string; description: string; icon?: "target" | "team" | "variation" | "review"; image?: Slot }[];
  stepLabel: string;
  needPrefix: string;
  fallbackLabel: string;
}
const { steps, stepLabel, needPrefix, fallbackLabel } = Astro.props;
const ICONS = ["target", "team", "variation", "review"] as const;
---
<ol role="list" class="flow" style={`--cols: ${Math.min(steps.length, 4)}`}>
  {steps.map((s, i) => (
    <li class="step">
      <span class="node"><FlowIcon name={s.icon ?? ICONS[i % ICONS.length]} /></span>
      <div class="body">
        <p class="t-label label"><Text value={stepLabel} /> {String(i + 1).padStart(2, "0")}</p>
        {s.image && <MediaSlot media={s.image} ratio="16 / 9" fallbackLabel={fallbackLabel} needPrefix={needPrefix} sizes="(max-width: 1023px) 80vw, 25vw" />}
        <h3 class="t-h4"><Text value={s.title} /></h3>
        <p class="t-muted"><Text value={s.description} /></p>
      </div>
    </li>
  ))}
</ol>
<style>
  .flow { position: relative; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .step { position: relative; display: grid; gap: var(--space-3); align-content: start; }
  .step::before { content: ""; position: absolute; top: 31px; left: 64px; right: calc(-1 * var(--gutter)); height: 2px; background: repeating-linear-gradient(90deg, var(--bxr-ash) 0 6px, transparent 6px 12px); }
  .step:last-child::before { display: none; }
  .node { position: relative; z-index: 1; display: grid; place-items: center; width: 64px; height: 64px; background: var(--bxr-black); color: var(--bxr-white); border-bottom: 2px solid var(--bxr-red); }
  .body { display: grid; gap: var(--space-1); align-content: start; }
  .label { color: var(--ink-muted); margin: 0; }
  @media (max-width: 1023px) {
    .flow { grid-template-columns: 1fr; gap: var(--space-5); }
    .step { grid-template-columns: 64px 1fr; gap: var(--space-3); align-items: start; }
    .step::before { top: 64px; bottom: calc(-1 * var(--space-5)); left: 31px; right: auto; width: 2px; height: auto; background: repeating-linear-gradient(180deg, var(--bxr-ash) 0 6px, transparent 6px 12px); }
  }
</style>
