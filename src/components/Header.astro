---
/**
 * Site header (DS P.12): 72 px, logo 32 px (28 px ≤ 1023 px), current item marked
 * with a 2 px BxR Red underline. ≤ 1023 px collapses into a menu button.
 * "Contact" is an outline button: red is reserved for the page's main action
 * (owner decision 2026-10-19).
 * Five top-level items: Solutions, Products, Technology, Resources, About BXR. "Resources" (News /
 * Insights / Case Studies) and "About BXR" (About Us / History / Team / Partners / Investors /
 * Contact) are disclosure buttons (not ARIA menus); pages in their lists mark the button as
 * current. The items come from src/lib/navigation.ts, shared with the Footer; the same data and
 * styles serve all three languages. A page that is not built yet shows as plain text, not a link.
 */
import { LANGS, LANG_LABEL, HREFLANG, localePath, type Lang } from "../i18n";
import { getUi } from "../lib/ui";
import { navigation, type NavKey, type ResourceKey, type CompanyKey } from "../lib/navigation";
import Logo from "./Logo.astro";
import Text from "./Text.astro";

export type { NavKey, ResourceKey, CompanyKey };
interface Props {
  lang: Lang;
  theme: "light" | "dark";
  current?: NavKey;
  /** Resources sub-page this page belongs to (marks the submenu item). */
  currentResource?: ResourceKey;
  /** About BXR sub-page this page belongs to (marks the submenu item). */
  currentCompany?: CompanyKey;
  /** URL of this page in each language; languages without the page fall back to their products overview. */
  langLinks: Record<Lang, string>;
}
const { lang, theme, current, currentResource, currentCompany, langLinks } = Astro.props;
const ui = getUi(lang);
// Menu items come from src/lib/navigation.ts (shared with the Footer). Child ids are unique
// across groups, so one value marks the current submenu item whichever group it is in.
const currentSub: string | undefined = currentResource ?? currentCompany;
const entries = navigation(lang);
const langNames: Record<Lang, string> = { en: "English", tw: "繁體中文", jp: "日本語" };
---
<header class="site-header" data-theme={theme}>
  <div class="container bar">
    <a class="logo" href={localePath(lang)} aria-label={ui.logoHome}><Logo theme={theme} /></a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-open-label={ui.menuOpen} data-close-label={ui.menuClose}>
      <svg class="i-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
      <svg class="i-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
      <span class="visually-hidden menu-label">{ui.menuOpen}</span>
    </button>

    <div class="menu" id="site-menu">
      <nav aria-label={ui.nav.label}>
        <ul role="list" class="nav-list">
          {entries.map((item) =>
            item.children.length === 0 ? (
              <li>
                {item.href
                  ? <a class="nav-link" href={item.href} aria-current={item.id === current ? "page" : undefined}><Text value={item.label} /></a>
                  : <span class="nav-link is-planned"><Text value={item.label} /><span class="visually-hidden"> <Text value={ui.nav.planned} /></span></span>}
              </li>
            ) : (
              <li class="has-sub" data-disclosure>
                <div class="nav-heading">
                {item.href && <a class="nav-link" href={item.href} aria-current={current === item.id ? "page" : undefined}><Text value={item.label} /></a>}
                <button type="button" class:list={["nav-link", "sub-toggle", { "is-current": current === item.id }]} aria-expanded="false" aria-controls={`sub-${item.id}`} aria-label={item.href ? item.label : undefined}>
                  {!item.href && <Text value={item.label} />}
                  <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M2.5 4.5L6 8l3.5-3.5" /></svg>
                </button>
                </div>
                <ul role="list" class="sub" id={`sub-${item.id}`}>
                  {item.children.map((r) => (
                    <li>
                      {r.href
                        ? <a class="sub-link" href={r.href} aria-current={r.id === currentSub ? "page" : undefined}><Text value={r.label} /></a>
                        : <span class="sub-link is-planned"><Text value={r.label} /><span class="visually-hidden"> <Text value={ui.nav.planned} /></span></span>}
                    </li>
                  ))}
                </ul>
              </li>
            ),
          )}
        </ul>
      </nav>
      <div class="tools">
        <a class="icon-link" href={localePath(lang, "search")}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" /></svg>
          <span class="visually-hidden"><Text value={ui.search} /></span>
        </a>
        <ul role="list" class="langs" aria-label={ui.languageLabel}>
          {LANGS.map((l) => (
            <li>
              <a href={langLinks[l]} hreflang={HREFLANG[l]} lang={HREFLANG[l]} aria-current={l === lang ? "true" : undefined}>{LANG_LABEL[l]}<span class="visually-hidden"> {langNames[l]}</span></a>
            </li>
          ))}
        </ul>
        <a class="btn btn--secondary btn--sm contact" href={localePath(lang, "contact")}><Text value={ui.contact} /></a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = header?.querySelector<HTMLElement>("#site-menu");
  const label = toggle?.querySelector<HTMLElement>(".menu-label");
  const mobile = window.matchMedia("(max-width: 1023px)");

  if (header && toggle && menu && label) {
    const focusables = () =>
      [toggle, ...menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")].filter((el) => el.offsetParent !== null);

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!;
      header.classList.toggle("is-open", open);
      document.documentElement.classList.toggle("menu-open", open);
      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));

    header.addEventListener("keydown", (e) => {
      if (!header.classList.contains("is-open")) return;
      if (e.key === "Escape") {
        setOpen(false, true);
      } else if (e.key === "Tab") {
        // keep focus inside the open menu
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    mobile.addEventListener("change", () => setOpen(false));
  }

  // Resources disclosure: Enter/Space or click toggles, Esc closes and returns focus, leaving the
  // item (focus or click elsewhere) closes it. With a mouse on desktop it also opens on hover and
  // closes shortly after the pointer leaves (a short delay plus a bridge under the button keeps it
  // open while the pointer crosses to the list). Touch and keyboard use the button only.
  const hoverDesktop = window.matchMedia("(min-width: 1024px) and (hover: hover)");
  for (const item of document.querySelectorAll<HTMLElement>("[data-disclosure]")) {
    const button = item.querySelector<HTMLButtonElement>("button")!;
    const set = (open: boolean) => {
      if (open) for (const other of document.querySelectorAll(".sub-toggle")) if (other !== button) other.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-expanded", String(open));
    };
    item.classList.add("is-enhanced");
    let byHover = false;
    let timer: number | undefined;
    button.addEventListener("click", () => {
      if (byHover && !button.parentElement?.querySelector("a")) { byHover = false; return; }
      byHover = false;
      set(button.getAttribute("aria-expanded") !== "true");
    });
    item.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse" || !hoverDesktop.matches) return;
      clearTimeout(timer);
      if (button.getAttribute("aria-expanded") !== "true") { set(true); byHover = true; }
    });
    item.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse" || !hoverDesktop.matches) return;
      clearTimeout(timer);
      timer = window.setTimeout(() => { if (byHover) { byHover = false; set(false); } }, 160);
    });
    item.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" && e.target === button) { e.preventDefault(); set(true); item.querySelector<HTMLElement>(".sub a")?.focus(); }
      if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        e.stopPropagation();
        set(false);
        button.focus();
      }
    });
    item.addEventListener("focusout", (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) set(false);
    });
    document.addEventListener("click", (e) => {
      if (!item.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--surface); color: var(--ink);
    border-bottom: 1px solid var(--divider);
  }
  .bar { display: flex; align-items: center; gap: var(--space-5); height: var(--header-h); }
  .logo { display: inline-flex; flex: none; }
  .logo:focus-visible { outline-offset: 4px; }
  .menu { display: flex; align-items: center; flex: 1; gap: var(--space-4); }
  .nav-list { display: flex; flex-wrap: nowrap; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .nav-link {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--ink); text-decoration: none; font-size: var(--fs-nav); font-weight: 500; line-height: 1; white-space: nowrap;
    border-bottom: 2px solid transparent; padding-top: 2px;
    transition: border-color var(--dur-micro) var(--ease-precise);
  }
  .nav-link:hover { border-bottom-color: var(--divider); }
  .nav-link[aria-current="page"], .nav-link.is-current { border-bottom-color: var(--bxr-red); }
  .is-planned { color: var(--ink-muted); cursor: default; }
  .nav-link.is-planned:hover { border-bottom-color: transparent; }
  .sub-link.is-planned:hover { background: none; }
  .sub-toggle { gap: 6px; background: none; border-top: 0; border-inline: 0; padding-inline: 0; cursor: pointer; font-family: inherit; }
  .chev { display: block; flex: none; transform-origin: 50% 50%; transition: transform var(--dur-micro) var(--ease-precise); }
  .sub-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .has-sub { position: relative; }
  .nav-heading { display: flex; align-items: center; }
  .nav-heading > a { flex: 1; }
  .nav-heading > a + .sub-toggle { flex: none; width: 24px; justify-content: center; }
  @media (max-width: 1023px) { .nav-heading > a + .sub-toggle { width: 44px; } }
  .sub { margin: 0; padding: var(--space-1) 0; list-style: none; }
  .is-enhanced .sub { display: none; }
  .is-enhanced:has(.sub-toggle[aria-expanded="true"]) .sub { display: block; }
  .sub-link {
    display: flex; align-items: center; min-height: 44px; padding-inline: var(--space-3);
    color: var(--ink); text-decoration: none; font-size: var(--fs-nav); white-space: nowrap;
  }
  .sub-link:hover { background: var(--bxr-paper); }
  .sub-link[aria-current="page"] { box-shadow: inset 2px 0 0 var(--bxr-red); }
  @media (min-width: 1024px) {
    /* Without JavaScript the submenu opens on hover and when the button has keyboard focus. */
    .sub {
      position: absolute; top: 100%; left: calc(-1 * var(--space-3)); z-index: 60; min-width: 200px; display: none;
      background: var(--bxr-white); border: 1px solid var(--bxr-line); box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    }
    .sub-link { color: var(--bxr-black); }
    /* Invisible bridge so the pointer never leaves the item between the button and the list. */
    .sub::before { content: ""; position: absolute; left: 0; right: 0; top: -12px; height: 12px; }
    .is-enhanced:has(.sub-toggle[aria-expanded="true"]) .sub,
    :global(.no-js) .has-sub:is(:hover, :focus-within) .sub { display: block; }
  }
  .tools { display: flex; align-items: center; gap: var(--space-3); margin-left: auto; }
  /* Narrow desktops: tighter gaps (never a smaller font) so all five items, search, language and contact stay on one row in every language. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .bar { gap: var(--space-3); }
    .menu, .tools { gap: var(--space-2); }
    .nav-list { gap: var(--space-3); }
    .langs a { min-width: 28px; }
  }
  @media (min-width: 1024px) and (max-width: 1139px) { .nav-list { gap: var(--space-1); } .bar { padding-inline: 20px; gap: var(--space-1); } .menu, .tools { gap: var(--space-1); } }
  .icon-link { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--ink); }
  .langs { display: flex; gap: 0; margin: 0; padding: 0; list-style: none; font-family: var(--font-mono); font-size: 13px; }
  .langs li + li::before { content: "/"; color: var(--ink-muted); padding-inline: 2px; }
  .langs a {
    display: inline-flex; align-items: center; justify-content: center; min-width: 32px; min-height: 44px;
    color: var(--ink-muted); text-decoration: none;
  }
  .langs a:hover { color: var(--ink); }
  .langs a[aria-current="true"] { color: var(--ink); text-decoration: underline; text-underline-offset: 0.3em; }
  .menu-toggle {
    display: none; margin-left: auto; width: 44px; height: 44px; align-items: center; justify-content: center;
    background: none; border: 0; color: var(--ink); cursor: pointer;
  }
  .i-close { display: none; }

  @media (max-width: 1023px) {
    .menu-toggle { display: inline-flex; }
    .menu {
      display: none;
      position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
      flex-direction: column; align-items: stretch; gap: var(--space-4);
      padding: var(--space-4) var(--margin) var(--space-8);
      background: var(--surface); overflow-y: auto;
    }
    .is-open .menu { display: flex; }
    .is-open .i-open { display: none; }
    .is-open .i-close { display: block; }
    .nav-list { flex-direction: column; gap: 0; }
    .nav-link { width: 100%; min-height: 56px; border-bottom: 1px solid var(--divider); }
    .nav-link[aria-current="page"], .nav-link.is-current { border-bottom: 2px solid var(--bxr-red); }
    .sub-toggle { justify-content: space-between; }
    .sub { padding: 0 0 var(--space-1) var(--space-3); }
    .sub-link { min-height: 48px; padding-inline: 0; }
    .tools { flex-wrap: wrap; margin-left: 0; }
    .contact { flex-basis: 100%; min-height: var(--btn-h); }
  }
  /* Without JavaScript the menu stays reachable as a plain list under the bar. */
  :global(.no-js) .menu-toggle { display: none; }
  @media (max-width: 1023px) {
    :global(.no-js) .site-header { position: static; }
    :global(.no-js) .bar { height: auto; flex-wrap: wrap; padding-block: var(--space-2); }
    :global(.no-js) .menu { display: flex; position: static; padding: 0; }
  }
  :global(html.menu-open) { overflow: hidden; }
</style>
