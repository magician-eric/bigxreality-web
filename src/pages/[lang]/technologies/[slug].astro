---
import Text from '../../../components/Text.astro';
import { LANGS, HTML_LANG, localePath, type Lang } from "../../../i18n";
import { technologyRelations, technologyRelationNotes } from "../../../data/technology-relations";
import { technologyContent } from "../../../data/technologies-content";
import { LIVE_TECHNOLOGY_IDS, technologyResources } from "../../../lib/technologies";
import { getLocalized } from "../../../lib/content";
import { getUi } from "../../../lib/ui";
import { site } from "../../../lib/site";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { technologyMedia } from "../../../lib/technology-media";
import PageHero from "../../../components/PageHero.astro";
import TechnologySections from "../../../components/TechnologySections.astro";
import RelatedTechnologyArticles from "../../../components/RelatedTechnologyArticles.astro";
import CardProduct from "../../../components/CardProduct.astro";
import CardSolution from "../../../components/CardSolution.astro";
import FaqAccordion from "../../../components/FaqAccordion.astro";
import CtaBand from "../../../components/CtaBand.astro";

export function getStaticPaths() { return LANGS.flatMap((lang) => LIVE_TECHNOLOGY_IDS.map((slug) => ({ params: { lang, slug } }))); }
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as keyof typeof technologyContent;
const content = technologyContent[slug][lang];
const ui = getUi(lang);
const relations = technologyRelations[slug];
const allProducts = await getLocalized("products", lang);
const allSolutions = await getLocalized("solutions", lang);
// Resolve approved entries only. Subject links never assert implementation or interoperability.
const products = technologyResources(allProducts, relations.products);
const solutions = technologyResources(allSolutions, relations.solutions);
const relationNotes = technologyRelationNotes[slug as keyof typeof technologyRelationNotes]?.[lang] ?? [];
const relatedLabels = { tw: { products: slug === "ai-simulation" ? "相關應用領域" : "相關產品", solutions: "相關解決方案" }, en: { products: slug === "ai-simulation" ? "Related Application Areas" : "Related Products", solutions: "Related Solutions" }, jp: { products: slug === "ai-simulation" ? "関連する活用分野" : "関連製品", solutions: "関連ソリューション" } };
const imageSlotLabel = { tw: "技術應用圖片位置", en: "Technology application image", jp: "技術活用イメージの掲載位置" };
const breadcrumbs = [{ name: ui.home, path: localePath(lang) }, { name: ui.nav.technologies, path: localePath(lang, "technologies") }, { name: content.title, path: localePath(lang, "technologies", slug) }];
const faqTitle = { tw: "常見問題", en: "Frequently Asked Questions", jp: "よくある質問" };
// BXR is not a government/health authority: omit FAQPage rich-result markup, retain full visible FAQ HTML.
const structuredData = [{ "@type": "WebPage", name: content.title, description: content.seo.description, inLanguage: HTML_LANG[lang], url: new URL(localePath(lang, "technologies", slug), site.url).href, about: { "@type": "Thing", name: content.title }, isPartOf: { "@type": "CollectionPage", url: new URL(localePath(lang, "technologies"), site.url).href } }];
---
<BaseLayout hidePendingFooter lang={lang} title={content.seo.title} description={content.seo.description} pathTemplate={`/{lang}/technologies/${slug}/`} alternates={[...LANGS]} headerTheme="dark" current="technologies" breadcrumbs={breadcrumbs} structuredData={structuredData}>
  <div class={`technology-page technology-${slug}`}>
    <PageHero breadcrumbs={breadcrumbs} breadcrumbLabel={ui.breadcrumbLabel} eyebrow={content.eyebrow} title={content.title} lead={content.lead} description={content.intro.join("\n\n")} image={technologyMedia(slug,lang)} imageBadge={technologyMedia(slug,lang)?.illustration ? ({tw:"概念視覺",en:"Concept visual",jp:"コンセプトビジュアル"}[lang]) : undefined}>
      <div slot="actions" class="technology-actions"><a class="btn btn--primary" href={localePath(lang, relations.primaryDestination)}>{content.primaryCta}</a><a class="btn btn--secondary" href={localePath(lang, "contact")}>{content.secondaryCta}</a></div>
    </PageHero>
    <TechnologySections sections={content.sections} variant={slug} />
    <section class="section related-resources" id="related-resources" aria-labelledby="h-related-resources">
      <div class="container">
        <h2 class="t-h2" id="h-related-resources"><Text value={content.relatedTitle} /></h2>
        {relationNotes.length > 0 && <div class="relation-notes">{relationNotes.map((note) => <p>{note}</p>)}</div>}
        {products.length > 0 && solutions.length > 0 && <p class="t-label resource-heading">{relatedLabels[lang].products}</p>}
        {products.length > 0 && <ul class="resources" role="list" data-related-products>{products.map((product) => <li><CardProduct lang={lang} href={localePath(lang, "products", product.slug)} name={product.loc.data.hero.name} summary={product.loc.data.summary ?? product.loc.data.hero.tagline} domains={product.base.data.domains} /></li>)}</ul>}
        {products.length > 0 && solutions.length > 0 && <p class="t-label resource-heading">{relatedLabels[lang].solutions}</p>}
        {solutions.length > 0 && <ul class="resources" role="list" data-related-solutions>{solutions.map((solution) => <li><CardSolution lang={lang} href={localePath(lang, "solutions", solution.slug)} domain={solution.base.data.domain} name={solution.loc.data.name} summary={solution.loc.data.summary} /></li>)}
        </ul>}
      </div>
    </section>
    <RelatedTechnologyArticles lang={lang} technology={slug} />
    <FaqAccordion id="technology-faq" title={faqTitle[lang]} items={content.faq} />
    <CtaBand id="technology-cta" title={content.closing.title} description={content.closing.body}><a class="btn btn--primary" href={localePath(lang, "contact")}>{content.closing.cta}</a></CtaBand>
  </div>
</BaseLayout>
<style>
  .technology-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .technology-page :global(.btn) { max-width: 100%; white-space: normal; overflow-wrap: anywhere; height: auto; min-height: var(--btn-h); text-align: center; }
  .technology-page :global(.page-hero .copy) { min-width: 0; }
  .technology-page :global(.breadcrumb li) { min-width: 0; overflow-wrap: anywhere; }
  .related-resources { background: var(--bxr-paper); }
  .related-resources h2 { margin-bottom: var(--space-5); max-width: 46rem; }
  .relation-notes { max-width: 52rem; display: grid; gap: var(--space-2); margin-bottom: var(--space-5); }
  .resource-heading { margin-block: var(--space-5) var(--space-3); }
  .resources { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .technology-page :global(.card img), .technology-page :global(.card a) { transition: none; }
  .technology-page :global(.card:hover img) { transform: none; }
  .technology-page :global(.item[open] .a) { animation: none !important; }
  .technology-domain-expertise :global(.page-hero) { border-bottom: 6px solid var(--bxr-brass); }
  .technology-ai-simulation :global(.page-hero) { border-bottom: 6px solid var(--bxr-brass); }
  .technology-digital-simulation :global(.page-hero) { border-bottom: 6px solid var(--bxr-signal-teal); }
  .technology-system-integration :global(.page-hero) { border-bottom: 6px solid var(--sector-police-deep); }
  .technology-decision-visualization :global(.page-hero) { border-bottom: 6px solid var(--sector-army-deep); }
  .technology-training-design :global(.page-hero) { border-bottom: 6px solid var(--bxr-signal-teal); }
  @media (max-width: 1023px) { .resources { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .resources { grid-template-columns: 1fr; } }
</style>
