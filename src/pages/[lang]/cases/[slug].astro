---
/** /[lang]/cases/[slug]/ — one template for every published case (components/CaseDetail.astro). */
import { LANGS } from "../../../i18n";
import { getArticles } from "../../../lib/articles";
import { validateRelations } from "../../../lib/content";
import CaseDetail from "../../../components/CaseDetail.astro";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) for (const article of await getArticles("case-studies", lang)) paths.push({ params: { lang, slug: article.slug }, props: { article } });
  return paths;
}
await validateRelations();
const { article } = Astro.props;
---
<CaseDetail article={article} />
