---
import { publicUrl } from '../../../lib/public-url.ts';

/** /[lang]/solutions/ — the four market domains (docs/PHASE-2-PLAN.md §4). */
import { getEntry } from "astro:content";
import { LANGS, localePath, type Lang } from "../../../i18n";
import { getLocalized } from "../../../lib/content";
import { getUi } from "../../../lib/ui";
import { plain } from "../../../lib/text";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import CardSolution from "../../../components/CardSolution.astro";
import CtaBand from "../../../components/CtaBand.astro";
import SectionHead from "../../../components/SectionHead.astro";
import ValueCards from "../../../components/ValueCards.astro";
import FormButton from "../../../components/FormButton.astro";
import { site } from "../../../lib/site";
import { isPending } from "../../../lib/pending";
import Text from "../../../components/Text.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = getUi(lang);
const page = (await getEntry("pages", `${lang}/solutions`))!.data;
// Only the four categories; solutions that belong to one (MUM-T, NOVA) are reached from their category page.
const solutions = (await getLocalized("solutions", lang)).filter((s) => !s.base.data.parent);
const breadcrumbs = [
  { name: ui.home, path: localePath(lang) },
  { name: ui.nav.solutions, path: localePath(lang, "solutions") },
];
const itemList = {
  "@type": "CollectionPage",
  name: plain(page.hero.title),
  url: publicUrl(localePath(lang, "solutions")).toString(),
  mainEntity: {
    "@type": "ItemList",
    itemListElement: solutions.map((s, i) => ({ "@type": "ListItem", position: i + 1, url: publicUrl(localePath(lang, "solutions", s.slug)).toString() })),
  },
};
---
<BaseLayout
  lang={lang} title={page.seo.title} description={page.seo.description} pathTemplate="/{lang}/solutions/"
  alternates={[...LANGS]} pendingTranslation={page.translationStatus === "pending"} headerTheme="dark" current="solutions"
  breadcrumbs={breadcrumbs} structuredData={[itemList]}
>
  <PageHero breadcrumbs={breadcrumbs} breadcrumbLabel={ui.breadcrumbLabel} eyebrow={page.hero.eyebrow} title={page.hero.title} lead={page.hero.lead} description={page.hero.description} image={page.hero.image} imageCaption={page.hero.imageCaption} />
  <section class="section" id="solution-list" aria-label={page.hero.title}>
    <div class="container">
      <ul role="list" class="cards">
        {solutions.map((s) => (
          <li>
            <CardSolution
              lang={lang} href={localePath(lang, "solutions", s.slug)} domain={s.base.data.domain}
              name={s.loc.data.name} summary={s.loc.data.summary} label={s.loc.data.cardLabel} headline={s.loc.data.cardHeadline} headingLevel={2}
              image={s.base.data.image && { src: s.base.data.image.src, alt: s.loc.data.image?.alt ?? s.base.data.image.alt }}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
  {page.highlights && (
    <section class="section section--alt" aria-labelledby="h-highlights">
      <div class="container">
        <SectionHead id="h-highlights" eyebrow={ui.productLanding.eyebrows.approach} title={page.highlights.title} />
        <ValueCards items={page.highlights.items} />
      </div>
    </section>
  )}
  {page.cta && !isPending(page.cta.title) && (
    <CtaBand id="solutions-cta" title={page.cta.title} description={page.cta.description}>
      <a class="btn btn--primary" href={localePath(lang, "contact")}><Text value={page.cta.button ?? ui.contact} /></a>
    </CtaBand>
  )}
</BaseLayout>
<style>
  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 767px) { .cards { grid-template-columns: 1fr; } }
</style>
