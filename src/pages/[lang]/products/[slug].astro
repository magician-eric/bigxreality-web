---
/**
 * /[lang]/products/[slug]/ — the fixed 12-block product template (task brief §5.2).
 * A block whose field is left out is not rendered; a field holding [待提供] is
 * rendered with the marker visible. Products with a `landing` block use the sales
 * landing page instead (components/ProductLanding.astro).
 */
import { LANGS, localePath, type Lang } from "../../../i18n";
import { getLocalized, availableLangs, integratedProducts, validateRelations } from "../../../lib/content";
import { articlesAbout, articleHref, tagNames } from "../../../lib/articles";
import { casesAbout } from "../../../lib/cases";
import RelatedCases from "../../../components/RelatedCases.astro";
import { visibleProductSections, isPending, type ProductSection } from "../../../lib/pending";
import { getUi } from "../../../lib/ui";
import { markPendingHtml, typesetHtml } from "../../../lib/text";
import RelatedTechnologies from "../../../components/RelatedTechnologies.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import SectionHead from "../../../components/SectionHead.astro";
import CardProduct from "../../../components/CardProduct.astro";
import CardSolution from "../../../components/CardSolution.astro";
import CardArticle from "../../../components/CardArticle.astro";
import CtaBand from "../../../components/CtaBand.astro";
import FormButton from "../../../components/FormButton.astro";
import Text from "../../../components/Text.astro";
import ProductLanding from "../../../components/ProductLanding.astro";
import { pageOgImage } from "../../../lib/og-image";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const p of await getLocalized("products", lang)) paths.push({ params: { lang, slug: p.slug } });
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
await validateRelations();
const ui = getUi(lang);
const product = (await getLocalized("products", lang)).find((p) => p.slug === slug)!;
const base = product.base.data; // structural fields (tw)
const d = product.loc.data; // wording in this language
const overview = product.loc.body?.trim();
const overviewHtml = typesetHtml(markPendingHtml(product.loc.rendered?.html ?? ""), lang);

const heroImage = base.hero.image && { src: base.hero.image.src, alt: d.hero.image?.alt ?? base.hero.image.alt };
const integrated = await integratedProducts(slug, lang);
const solutions = (await getLocalized("solutions", lang)).filter((s) => (base.relatedSolutions ?? []).includes(s.slug));
// Cases have their own block (RelatedCases); this list keeps news and insights.
const articles = (await articlesAbout("relatedProducts", slug, lang, ["news", "insights"])).slice(0, 6);
const cases = await casesAbout("relatedProducts", slug, lang);
const articleTags = await Promise.all(articles.map((a) => tagNames(a.base.data.tags, lang)));

const deployment = d.deployment && {
  personnel: base.deployment?.personnel,
  area: base.deployment?.area,
  setupTime: base.deployment?.setupTime,
  notes: d.deployment.notes,
};

const sections = visibleProductSections({
  overview,
  capabilities: d.capabilities,
  howItWorks: d.howItWorks,
  scenarios: d.scenarios,
  components: d.components,
  deployment,
  integratedOps: { description: d.integratedOps?.description, products: integrated.map((p) => p.slug) },
  relatedSolutions: solutions.map((s) => s.slug),
  relatedArticles: articles.map((a) => a.slug),
});
const has = (s: ProductSection) => sections.includes(s);
const head = (s: ProductSection) => ui.product.sections[s];

const alternates = await availableLangs("products", slug);
const breadcrumbs = [
  { name: ui.home, path: localePath(lang) },
  { name: ui.nav.products, path: localePath(lang, "products") },
  { name: d.hero.name, path: localePath(lang, "products", slug) },
];
// og:image and the Product schema image: this page's hero with this language's own alt.
const og = pageOgImage(base.seo?.ogImage ?? heroImage?.src, d.hero.image?.alt, product.pendingTranslation);
const t = ui.product.deployment;
const amount = (v: number | string | undefined, unit: string) => (v === undefined ? undefined : isPending(v) ? v : `${v} ${unit}`);
const personnel =
  deployment?.personnel === undefined
    ? undefined
    : isPending(deployment.personnel)
      ? deployment.personnel
      : `${deployment.personnel.approx ? t.approx + " " : ""}${deployment.personnel.min}–${deployment.personnel.max} ${t.personUnit}`;
const deploymentRows = [
  [t.personnel, personnel],
  [t.area, amount(deployment?.area, t.areaUnit)],
  [t.setupTime, amount(deployment?.setupTime, t.minuteUnit)],
  [t.notes, deployment?.notes],
].filter((r): r is [string, string] => r[1] !== undefined);
---
{d.landing ? (
  <ProductLanding lang={lang} slug={slug} base={base} data={d} pendingTranslation={product.pendingTranslation} />
) : (
<BaseLayout
  lang={lang}
  title={d.seo?.title ?? d.hero.name}
  description={d.seo?.description ?? d.hero.tagline}
  pathTemplate={`/{lang}/products/${slug}/`}
  alternates={alternates}
  pendingTranslation={product.pendingTranslation}
  headerTheme="dark"
  current="products"
  breadcrumbs={breadcrumbs}
  {...og}
  search={{ type: "products" }}
  product={{ name: d.hero.name, description: d.seo?.description ?? d.hero.tagline, code: base.hero.code }}
>
  <!-- 1 Hero -->
  <PageHero
    breadcrumbs={breadcrumbs}
    breadcrumbLabel={ui.breadcrumbLabel}
    eyebrow={ui.productLanding.eyebrow}
    title={d.hero.name}
    subtitle={d.hero.englishName}
    description={d.hero.tagline}
    image={heroImage}
    imagePending={ui.imagePending}
  >
    {(base.cta?.brochure ?? true) && <FormButton slot="actions" kind="brochure" lang={lang} productCode={base.hero.code} variant="primary" />}
    {(base.cta?.demo ?? true) && <FormButton slot="actions" kind="demo" lang={lang} productCode={base.hero.code} variant="secondary" />}
  </PageHero>

  <!-- 2 In-page navigation, generated from the sections that have data -->
  {sections.length > 1 && (
    <nav class="toc" aria-label={ui.product.onThisPage} data-toc>
      <div class="container">
        <ul role="list">
          {sections.map((s) => <li><a href={`#${s}`}><Text value={head(s).title} /></a></li>)}
        </ul>
      </div>
    </nav>
  )}

  <!-- 3 Overview -->
  {has("overview") && (
    <section class="section" id="overview" aria-labelledby="h-overview">
      <div class="container two-col">
        <SectionHead id="h-overview" eyebrow={head("overview").eyebrow} title={head("overview").title} />
        <div class="prose" set:html={overviewHtml} />
      </div>
    </section>
  )}

  <!-- 4 Capabilities -->
  {has("capabilities") && (
    <section class="section section--alt" id="capabilities" aria-labelledby="h-capabilities">
      <div class="container">
        <SectionHead id="h-capabilities" eyebrow={head("capabilities").eyebrow} title={head("capabilities").title} />
        <ul role="list" class="tiles">
          {d.capabilities!.map((c) => (
            <li class="tile"><h3 class="t-h4"><Text value={c.title} /></h3><p class="t-muted"><Text value={c.description} /></p></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 5 How it works -->
  {has("howItWorks") && (
    <section class="section" id="howItWorks" aria-labelledby="h-howItWorks">
      <div class="container">
        <SectionHead id="h-howItWorks" eyebrow={head("howItWorks").eyebrow} title={head("howItWorks").title} />
        <ol role="list" class="steps">
          {d.howItWorks!.map((s, i) => (
            <li class="step">
              <span class="t-tech num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="t-h4"><Text value={s.title} /></h3>
              <p class="t-muted"><Text value={s.description} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- 6 Training scenarios -->
  {has("scenarios") && (
    <section class="section section--alt" id="scenarios" aria-labelledby="h-scenarios">
      <div class="container">
        <SectionHead id="h-scenarios" eyebrow={head("scenarios").eyebrow} title={head("scenarios").title} />
        <ul role="list" class="tiles">
          {d.scenarios!.map((s) => (
            <li class="tile"><h3 class="t-h4"><Text value={s.title} /></h3><p class="t-muted"><Text value={s.description} /></p></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 7 System components -->
  {has("components") && (
    <section class="section" id="components" aria-labelledby="h-components">
      <div class="container">
        <SectionHead id="h-components" eyebrow={head("components").eyebrow} title={head("components").title} />
        <dl class="spec">
          {d.components!.map((c) => (<div><dt><Text value={c.name} /></dt><dd><Text value={c.description} /></dd></div>))}
        </dl>
      </div>
    </section>
  )}

  <!-- 8 Deployment -->
  {has("deployment") && (
    <section class="section section--alt" id="deployment" aria-labelledby="h-deployment">
      <div class="container">
        <SectionHead id="h-deployment" eyebrow={head("deployment").eyebrow} title={head("deployment").title} />
        <dl class="figures">
          {deploymentRows.map(([k, v]) => (<div><dt class="t-label"><Text value={k} /></dt><dd><Text value={v} /></dd></div>))}
        </dl>
      </div>
    </section>
  )}

  <!-- 9 Integrated operations -->
  {has("integratedOps") && (
    <section class="section" id="integratedOps" aria-labelledby="h-integratedOps">
      <div class="container">
        <SectionHead id="h-integratedOps" eyebrow={head("integratedOps").eyebrow} title={head("integratedOps").title} description={d.integratedOps?.description} />
        {integrated.length > 0 && (
          <>
            <p class="t-label sublabel"><Text value={ui.product.integratesWith} /></p>
            <ul role="list" class="cards">
              {integrated.map((p) => (
                <li>
                  <CardProduct
                    lang={lang} href={localePath(lang, "products", p.slug)} name={p.loc.data.hero.name}
                    summary={p.loc.data.summary ?? p.loc.data.hero.tagline}
                    domains={p.base.data.domains}
                    image={p.base.data.hero.image && { src: p.base.data.hero.image.src, alt: p.loc.data.hero.image?.alt ?? p.base.data.hero.image.alt }}
                  />
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <!-- 10 Related solutions -->
  {has("relatedSolutions") && (
    <section class="section section--alt" id="relatedSolutions" aria-labelledby="h-relatedSolutions">
      <div class="container">
        <SectionHead id="h-relatedSolutions" eyebrow={head("relatedSolutions").eyebrow} title={head("relatedSolutions").title} />
        <ul role="list" class="cards">
          {solutions.map((s) => (
            <li>
              <CardSolution
                lang={lang} href={localePath(lang, "solutions", s.slug)} domain={s.base.data.domain}
                name={s.loc.data.name} summary={s.loc.data.summary}
                image={s.base.data.image && { src: s.base.data.image.src, alt: s.loc.data.image?.alt ?? s.base.data.image.alt }}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <RelatedCases lang={lang} cases={cases} />

  <!-- 11 Related articles (reverse lookup of relatedProducts) -->
  {has("relatedArticles") && (
    <section class="section" id="relatedArticles" aria-labelledby="h-relatedArticles">
      <div class="container">
        <SectionHead id="h-relatedArticles" eyebrow={head("relatedArticles").eyebrow} title={head("relatedArticles").title} />
        <ul role="list" class="cards">
          {articles.map((a, i) => (
            <li>
              <CardArticle
                lang={lang} href={articleHref(a)} type={ui.articleTypes[a.collection]}
                date={a.base.data.publishDate} title={a.loc.data.title} summary={a.loc.data.summary}
                tags={articleTags[i]}
                cover={a.base.data.cover && { src: a.base.data.cover.src, alt: a.loc.data.cover?.alt ?? a.base.data.cover.alt }}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <RelatedTechnologies lang={lang} collection="products" slug={slug} />

  <!-- 12 CTA -->
  {d.cta && (
    <CtaBand id="product-cta" title={d.cta.title} description={d.cta.description}>
      {(base.cta?.brochure ?? true) && <FormButton kind="brochure" lang={lang} productCode={base.hero.code} variant="primary" />}
      {(base.cta?.demo ?? true) && <FormButton kind="demo" lang={lang} productCode={base.hero.code} variant="secondary" />}
    </CtaBand>
  )}
</BaseLayout>
)}

<script>
  // Marks the in-page navigation item for the section currently in view.
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc && "IntersectionObserver" in window) {
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>("a")].map((a) => [a.hash.slice(1), a]));
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links.values()) a.removeAttribute("aria-current");
          links.get(e.target.id)?.setAttribute("aria-current", "location");
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    for (const id of links.keys()) {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    }
  }
</script>

<style>
  .toc { position: sticky; top: var(--header-h); z-index: 40; background: var(--bxr-white); border-bottom: 1px solid var(--bxr-line); }
  .toc ul { display: flex; gap: var(--space-4); margin: 0; padding: 0; list-style: none; overflow-x: auto; scrollbar-width: thin; }
  .toc a {
    display: inline-flex; align-items: center; min-height: 48px; white-space: nowrap;
    color: var(--bxr-slate); text-decoration: none; font-size: var(--fs-small); font-weight: 500;
    border-bottom: 2px solid transparent;
  }
  .toc a:hover { color: var(--bxr-black); }
  .toc a[aria-current="location"] { color: var(--bxr-black); border-bottom-color: var(--bxr-black); }
  .toc a:focus-visible { outline-offset: -2px; }
  :global(html) { scroll-padding-top: calc(var(--header-h) + 48px + var(--space-2)); }

  .two-col { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
  .two-col :global(.section-head) { margin-bottom: 0; }
  .prose { display: grid; gap: var(--space-2); max-width: 44rem; }
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .tile { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-3); background: var(--surface); border-top: 2px solid var(--bxr-black); }
  .section--alt .tile { background: var(--bxr-white); }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; counter-reset: none; }
  .step { display: grid; gap: var(--space-1); align-content: start; padding-top: var(--space-2); border-top: 1px solid var(--bxr-line); }
  .num { color: var(--ink-muted); }
  .spec { display: grid; margin: 0; border-top: 1px solid var(--bxr-black); }
  .spec div { display: grid; grid-template-columns: 4fr 8fr; gap: var(--space-3); padding-block: var(--space-2); border-bottom: 1px solid var(--bxr-line); }
  .spec dt { font-weight: 500; }
  .spec dd { margin: 0; color: var(--ink-muted); }
  .figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gutter); margin: 0; }
  .figures div { display: grid; gap: var(--space-1); padding-top: var(--space-2); border-top: 1px solid var(--bxr-black); }
  .figures dt { color: var(--ink-muted); }
  .figures dd { margin: 0; font-size: var(--fs-h3); font-weight: 500; }
  .sublabel { color: var(--ink-muted); margin-bottom: var(--space-2); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  @media (max-width: 1023px) {
    .two-col { grid-template-columns: 1fr; gap: var(--space-3); }
    .tiles, .cards, .steps, .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .tiles, .cards, .steps, .figures { grid-template-columns: 1fr; }
    .spec div { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
