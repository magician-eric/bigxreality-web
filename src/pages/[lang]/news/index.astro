---
/** /[lang]/news/ — first page of the list (see components/NewsListPage.astro). */
import { LANGS, type Lang } from "../../../i18n";
import NewsListPage from "../../../components/NewsListPage.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
---
<NewsListPage lang={Astro.params.lang as Lang} page={1} />
