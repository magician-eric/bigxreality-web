---
/** The existing partner route: the shared, ordered client-logo catalogue. */
import { LANGS, type Lang } from '../../../../i18n';
import { clientLogos } from '../../../../lib/client-logos';
import CompanyShell from '../../../../components/CompanyShell.astro';
import ClientLogos from '../../../../components/ClientLogos.astro';
export const getStaticPaths = () => LANGS.map(lang => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<CompanyShell lang={lang} page="partners" currentCompany="partners" path="partners" empty={clientLogos(lang).length === 0} alternates={[...LANGS]}>
  <ClientLogos lang={lang} />
</CompanyShell>
