---
/** /[lang]/company/team/ — management team: only people who agreed to be listed (published entries). */
import { Picture } from "astro:assets";
import { LANGS, type Lang } from "../../../../i18n";
import { getLocalized } from "../../../../lib/content";
import { companyContent } from "../../../../lib/company";
import CompanyShell from "../../../../components/CompanyShell.astro";
import Text from "../../../../components/Text.astro";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const members = await getLocalized("team", lang);
const alternates: Lang[] = [];
for (const l of LANGS) if ((await companyContent(l)).team) alternates.push(l);
---
<CompanyShell lang={lang} page="team" currentCompany="team" path="team" empty={members.length === 0} alternates={alternates}>
  <ul role="list" class="grid">
    {members.map((m) => (
      <li class="card">
        {m.base.data.photo && (
          <figure class="photo">
            <Picture src={m.base.data.photo.src} alt={m.loc.data.photo?.alt ?? m.base.data.photo.alt} formats={["avif", "webp"]} widths={[320, 640]} sizes="(max-width: 767px) 100vw, 320px" width={640} height={800} fit="cover" loading="lazy" />
          </figure>
        )}
        <div class="body">
          <h2 class="t-h4"><Text value={m.loc.data.name} /></h2>
          <p class="t-tech role"><Text value={m.loc.data.role} /></p>
          {m.loc.data.bio && <p class="t-small t-muted"><Text value={m.loc.data.bio} /></p>}
        </div>
      </li>
    ))}
  </ul>
</CompanyShell>
<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); margin: 0; padding: 0; list-style: none; }
  .card { display: flex; flex-direction: column; border: 1px solid var(--divider); background: var(--surface); }
  .photo { margin: 0; }
  .photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .body { display: grid; gap: var(--space-1); padding: var(--space-3); }
  .body h2, .body p { margin: 0; }
  .role { color: var(--ink-muted); }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; } }
</style>
