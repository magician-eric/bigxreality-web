---
import { getEntry } from "astro:content";
import { marked } from "marked";
import { LANGS, type Lang } from "../../../../i18n";
import { teamLabels } from "../../../../data/team-labels";
import CompanyShell from "../../../../components/CompanyShell.astro";
export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const entry = (await getEntry("pages", `${lang}/team`))!;
const body = entry.body ?? "";
const boundary = body.indexOf("\n## ");
const intro = await marked.parse(boundary < 0 ? body : body.slice(0, boundary));
const capabilities = await marked.parse(boundary < 0 ? "" : body.slice(boundary));
const labels = teamLabels[lang];
---
<CompanyShell lang={lang} page="team" currentCompany="team" path="team" empty={false} alternates={[...LANGS]}>
  <div class="team-intro" set:html={intro} />
  <figure class="team-framework" aria-labelledby="team-framework-caption">
    <figcaption id="team-framework-caption">{labels.diagram}</figcaption>
    <div class="management">{labels.management}</div>
    <ul role="list" class="areas">{labels.areas.map((area) => <li>{area}</li>)}</ul>
  </figure>
  <div class="capabilities" set:html={capabilities} />
</CompanyShell>
<style>
  .team-intro { max-width: 800px; }
  .team-intro :global(p) { line-height: 1.8; margin: 0 0 1em; }
  .team-framework { margin: var(--space-5) 0; padding: var(--space-4); background: var(--bxr-paper); border: 1px solid var(--bxr-line); }
  figcaption { text-align: center; color: var(--ink-muted); font-size: 14px; margin-bottom: var(--space-3); }
  .management { width: fit-content; max-width: 100%; margin: auto; padding: 16px 24px; text-align: center; background: var(--bxr-ink, #0b0f14); color: white; font-weight: 700; border-top: 3px solid #D02753; }
  .areas { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--gutter); padding: 24px 0 0; margin: 0; list-style: none; }
  .areas li { padding: 18px 12px; text-align: center; font-weight: 700; border-top: 2px solid #D02753; background: var(--surface, white); }
  .capabilities { max-width: 800px; }
  .capabilities :global(h2) { font-size: clamp(20px,2vw,24px); line-height: 1.5; margin: 32px 0 12px; }
  .capabilities :global(p) { line-height: 1.8; margin: 0; }
  @media(max-width:767px) { .areas { grid-template-columns: 1fr; gap: 12px; } .team-framework { padding: 20px 16px; } }
</style>
