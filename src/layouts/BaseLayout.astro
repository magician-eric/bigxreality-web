---
import "../styles/global.css";
import { HTML_LANG, LANGS, localePath, type Lang } from "../i18n";
import { getUi } from "../lib/ui";
import SeoHead, { type Crumb, type ProductLd, type ArticleMeta } from "../components/SeoHead.astro";
import Header, { type NavKey, type ResourceKey } from "../components/Header.astro";
import { isFixtureBuild } from "../lib/content-source";
import Footer from "../components/Footer.astro";
import Text from "../components/Text.astro";
import type { ImageMetadata } from "astro";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pathTemplate: string;
  alternates: Lang[];
  /** Translation not finished: noindex, left out of the sitemap, banner on top (owner decision 2026-10-19). */
  pendingTranslation?: boolean;
  /** Other reasons not to index (empty list, tag page with few articles, search page). */
  noindex?: boolean;
  headerTheme: "light" | "dark";
  current?: NavKey;
  currentResource?: ResourceKey;
  /** Where the language switch goes when this page does not exist in a language (`{lang}` template). Default: products overview. */
  fallbackPath?: string;
  breadcrumbs: Crumb[];
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  product?: ProductLd;
  article?: ArticleMeta;
  structuredData?: Record<string, unknown>[];
  /** Detail pages that belong in site search (docs/PHASE-2-PLAN.md §5.2): result type and date. */
  search?: { type: "products" | "solutions" | "news" | "insights" | "case-studies"; date?: Date };
}
const p = Astro.props;
// TEST FIXTURE builds are never indexable, whatever the page says.
const noindex = !!(p.pendingTranslation || p.noindex || isFixtureBuild());
// Search follows the content rules only, so TEST FIXTURE builds can exercise search.
const searchable = !!p.search && !p.pendingTranslation && !p.noindex;
const ui = getUi(p.lang);
const langLinks = Object.fromEntries(
  LANGS.map((l) => [l, p.alternates.includes(l) ? p.pathTemplate.replace("{lang}", l) : p.fallbackPath ? p.fallbackPath.replace("{lang}", l) : localePath(l, "products")]),
) as Record<Lang, string>;
---
<!doctype html>
<html lang={HTML_LANG[p.lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace("no-js", "js");</script>
    <SeoHead
      lang={p.lang} title={p.title} description={p.description} pathTemplate={p.pathTemplate}
      alternates={p.alternates} noindex={noindex} breadcrumbs={p.breadcrumbs}
      ogImage={p.ogImage} ogImageAlt={p.ogImageAlt} product={p.product} article={p.article} structuredData={p.structuredData}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Font CSS is large (CJK unicode-range subsets); load it without blocking render. Text shows in the fallback font until it arrives (font-display: swap). -->
    <link rel="preload" href="/fonts/noto-sans-tc.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    {p.lang === "jp" && <link rel="preload" href="/fonts/noto-sans-jp.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />}
    <link rel="stylesheet" href="/fonts/b612-mono.css" />
    <noscript>
      <link rel="stylesheet" href="/fonts/noto-sans-tc.css" />
      {p.lang === "jp" && <link rel="stylesheet" href="/fonts/noto-sans-jp.css" />}
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main"><Text value={ui.skipToContent} /></a>
    <Header lang={p.lang} theme={p.headerTheme} current={p.current} currentResource={p.currentResource} langLinks={langLinks} />
    {p.pendingTranslation && (
      <div class="translation-banner" role="note"><div class="container t-small"><Text value={ui.translationPending} /></div></div>
    )}
    <main
      id="main" tabindex="-1"
      data-pagefind-body={searchable ? "" : undefined}
      data-search-type={searchable ? p.search!.type : undefined}
      data-search-date={searchable && p.search!.date ? p.search!.date.toISOString().slice(0, 10) : undefined}
    >
      <slot />
    </main>
    <Footer lang={p.lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute; left: var(--space-2); top: -100px; z-index: 100;
    padding: var(--space-1) var(--space-2); background: var(--bxr-white); color: var(--bxr-black);
  }
  .skip-link:focus { top: var(--space-2); }
  .translation-banner { background: var(--bxr-paper); border-bottom: 1px solid var(--bxr-line); padding-block: var(--space-1); color: var(--bxr-black); }
  main:focus { outline: none; }
</style>
