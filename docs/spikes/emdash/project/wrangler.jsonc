// SPIKE ONLY: local emulation. No remote resources; no account login exists in this environment.
{
  "name": "bxr-emdash-spike",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "bxr-spike-db", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bxr-spike-media" }],
  "triggers": { "crons": ["* * * * *"] }
}
